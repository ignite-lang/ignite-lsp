test fn sample() -> Result<Index, Text> = match index_of_output(SAMPLE_DOCUMENT, SAMPLE_TEXT) {
  Some(index) => Ok(index)
  None => Err("the sample's document gave no index")
}

// The byte offset of the `nth` (from 0) whole-word `word` in the sample, plus `into`.
test fn at(word: Text, nth: Int, into: Int) -> Int {
  let bytes = SAMPLE_TEXT.to_bytes()
  var from = 0
  var count = 0
  while count <= nth {
    match token(bytes, word, from, bytes.len()) {
      Some(span) => {
        if count == nth {
          return span.start + into
        }
        count = count + 1
        from = span.end
      }
      None => return -1
    }
  }
  -1
}

// The span of the `nth` whole-word `word`.
test fn word(name: Text, nth: Int) -> Span {
  let start = at(name, nth, 0)
  Span { start, end = start + name.len() }
}

test fn hover_at(index: Index, offset: Int) -> Option<Text> = match spot_at(index, offset) {
  Some(spot) => Some(spot.hover)
  None => None
}

test fn target_at(index: Index, offset: Int) -> Option<Span> = match spot_at(index, offset) {
  Some(spot) => spot.target
  None => None
}

test "a local's use shows its type and goes to its let" {
  let index = sample()?
  assert hover_at(index, at("wider", 1, 2)) == Some("let wider: Int")
  assert target_at(index, at("wider", 1, 2)) == Some(word("wider", 0))
}

test "a parameter's use goes to the parameter of its own fn" {
  let index = sample()?
  assert hover_at(index, at("by", 1, 0)) == Some("by: Int")
  assert target_at(index, at("by", 1, 0)) == Some(word("by", 0))
  assert target_at(index, at("box", 2, 1)) == Some(word("box", 0))
  assert target_at(index, at("box", 4, 1)) == Some(word("box", 3))
  assert target_at(index, at("box", 6, 1)) == Some(word("box", 5))
  assert hover_at(index, at("box", 8, 1)) == Some("let box: Box")
  assert target_at(index, at("box", 8, 1)) == Some(word("box", 7))
}

test "a shadowing let is used after it, the shadowed one in its own value" {
  let index = sample()?
  assert target_at(index, at("x", 2, 0)) == Some(word("x", 0))
  assert target_at(index, at("x", 3, 0)) == Some(word("x", 0))
  assert target_at(index, at("x", 4, 0)) == Some(word("x", 1))
}

test "a call of a fn of the document shows its signature and goes to it" {
  let index = sample()?
  assert hover_at(index, at("grow", 2, 1)) == Some("fn grow(box: Box, by: Int) -> Box")
  assert target_at(index, at("grow", 2, 1)) == Some(word("grow", 0))
  assert hover_at(index, at("twice", 1, 0)) == Some("fn twice(box: Box) -> Int")
  assert target_at(index, at("twice", 1, 0)) == Some(word("twice", 0))
}

test "a field goes to the record's field, a record literal to the record" {
  let index = sample()?
  assert hover_at(index, at("width", 1, 0)) == Some("Box.width: Int")
  assert target_at(index, at("width", 1, 0)) == Some(word("width", 0))
  assert hover_at(index, at("Box", 3, 0)) == Some("type Box {{\n  width: Int\n  label: Text\n}}")
  assert target_at(index, at("Box", 3, 0)) == Some(word("Box", 0))
}

test "a std method shows its callee and type and has no target" {
  let index = sample()?
  assert hover_at(index, at("split", 1, 2)) == Some("fn std.text.split(…) -> List<Text>")
  assert target_at(index, at("split", 1, 2)) == None
}

test "variants, pattern bindings and constants resolve" {
  let index = sample()?
  assert target_at(index, at("Square", 1, 0)) == Some(word("Square", 0))
  assert hover_at(index, at("Square", 2, 0)) == Some("Shape.Square(Int)")
  assert target_at(index, at("Square", 2, 0)) == Some(word("Square", 0))
  assert hover_at(index, at("side", 1, 0)) == Some("side: Int")
  assert target_at(index, at("side", 1, 0)) == Some(word("side", 0))
  assert hover_at(index, at("LIMIT", 1, 0)) == Some("const LIMIT: Int")
  assert target_at(index, at("LIMIT", 1, 0)) == Some(word("LIMIT", 0))
}

test "a literal shows its type and the space between names shows nothing" {
  let index = sample()?
  assert hover_at(index, at("30", 0, 0)) == Some("Int")
  assert spot_at(index, at("LIMIT", 0, 0) - 7) == None
}

test "the outline lists every declaration in order with its members" {
  let index = sample()?
  assert index.outline.map(|e| e.name) == ["Box", "Shape", "LIMIT", "grow", "size", "twice", "words", "grow adds"]
  assert index.outline.map(|e| e.kind) == [SymbolKind.Struct, SymbolKind.Enum, SymbolKind.Constant, SymbolKind.Function, SymbolKind.Function, SymbolKind.Function, SymbolKind.Function, SymbolKind.Event]
  assert index.outline[0].children.map(|e| (e.name, e.detail)) == [("width", "Int"), ("label", "Text")]
  assert index.outline[1].children.map(|e| (e.name, e.detail)) == [("Square", "(Int)"), ("Empty", "")]
  assert index.outline[3].detail == "(box: Box, by: Int) -> Box"
  assert index.outline[3].selection == word("grow", 0)
  assert index.outline[0].children[0].selection == word("width", 0)
}

test "a document printed for another text gives no index" {
  assert index_of_output(SAMPLE_DOCUMENT, "// one more line\n".concat(SAMPLE_TEXT)) == None
  assert index_of_output("{{}}", SAMPLE_TEXT) == None
  assert index_of_output("not json", SAMPLE_TEXT) == None
}
