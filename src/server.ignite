package lsp

import std.net.{Pipe, PipeStream}
import std.io.IoError
import std.json.{Json, parse, encode, get, text, int}
import std.option.{unwrap_or, and_then}
import std.result.map_err
import std.process.{Invocation, ChildExit}
import std.fs.read_text_file
import std.protocol.jsonrpc.{
  JsonRpcLimits, Frame, FrameError, Split, split_frame, content_length, frame, read_message,
  Message, Request, Notification, Response, ErrorObject, encode_message, decode_body,
  detected_id, notification_batch, READ_SIZE
}
import std.text.{bytes_find_from, to_lower, replace}
import std.rfc.language_server_3_17.{LANGUAGE_SERVER_3_17}
import lsp.lsp_types.{
  METHOD_INITIALIZE, METHOD_INITIALIZED, METHOD_SHUTDOWN, METHOD_EXIT,
  METHOD_TEXT_DOCUMENT_DID_OPEN, METHOD_TEXT_DOCUMENT_DID_CHANGE, METHOD_TEXT_DOCUMENT_DID_CLOSE,
  METHOD_TEXT_DOCUMENT_PUBLISH_DIAGNOSTICS, ErrorCodes, InitializeParams, InitializeResult,
  InitializeResultServerInfo, ServerCapabilities, ServerCapabilitiesTextDocumentSync,
  TextDocumentSyncOptions, TextDocumentSyncKind, PositionEncodingKind, DidOpenTextDocumentParams,
  DidChangeTextDocumentParams, DidCloseTextDocumentParams, TextDocumentContentChangeEvent,
  PublishDiagnosticsParams, Diagnostic, DiagnosticSeverity, DiagnosticCode, Range, Position,
  METHOD_TEXT_DOCUMENT_DID_SAVE, METHOD_TEXT_DOCUMENT_HOVER, METHOD_TEXT_DOCUMENT_DEFINITION,
  METHOD_TEXT_DOCUMENT_DOCUMENT_SYMBOL, DidSaveTextDocumentParams, HoverParams, DefinitionParams,
  DocumentSymbolParams, Hover, HoverContents, MarkupContent, MarkupKind, Location, Definition,
  TextDocumentDefinitionResult, TextDocumentDocumentSymbolResult, DocumentSymbol, SymbolKind,
  ServerCapabilitiesHoverProvider, ServerCapabilitiesDefinitionProvider,
  ServerCapabilitiesDocumentSymbolProvider, TextDocumentSyncOptionsSave
}
import lsp.typed.{Index, Span, Spot, Entry, index_of_output, spot_at, token}

// ignite-lsp: a language server for Ignite (story:lsp-server), LSP 3.17 over standard input
// and output. Every message type is the generated module `lsp_types.ignite`; JSON-RPC and the
// base protocol's framing are `std.protocol.jsonrpc`. It implements the lifecycle
// (`initialize`, `initialized`, `shutdown`, `exit`), full text synchronisation (`didOpen`,
// `didChange`, `didClose`, `didSave`), diagnostics, hover, go-to-definition and the document
// outline. Positions are in the negotiated encoding (UTF-8 when the client offers it, else
// UTF-16).
//
// Diagnostics: an opened or changed buffer goes to `ignite check --json --stdin-for PATH` on
// the child's stdin, and each diagnostic comes back as `textDocument/publishDiagnostics`. A
// change does not start a check at once: the buffer waits until the server has no complete
// message left to read, or is about to answer a request, so changes that arrive together, or
// while a check runs, are checked once, at their newest version. A diagnostic's empty range is
// widened to the token there (`widened`). While the buffer has a syntax error (E001, E002) the
// compiler reports only that, so the type errors of the last check without one are published
// beside it, marked `(before the syntax error)` and as warnings.
//
// Hover, definition and outline (`textDocument/hover`, `definition`, `documentSymbol`) answer
// from the index of `lsp.typed`, built from `ignite emit --typed-json` once per buffer
// version: on the file when the buffer is as saved, else on `/dev/stdin` with the buffer as
// input (`emit` has no `--stdin-for`, so a buffer that imports sibling modules gets no index
// until it is saved). A document printed for other text than the buffer's gives none.
//
// The compiler is the program the setting `--ignite` names: an absolute path, or a bare name
// looked up in `PATH` (`std.process.Invocation`). Its default is `ignite`, so an editor that
// starts `ignite-lsp` with `ignite` on its `PATH` needs no argument; `--ignite /path/to/ignite`
// picks another build.
//
// Closed enumerations in client capabilities: the generator decodes a list of a closed
// enumeration by skipping the values it does not know and an optional property holding one
// as absent (LSP 3.17, "Enumerations"), so a `valueSet` or a `failureHandling` naming a value
// newer than 3.17 still decodes and `initialize` succeeds. Params that still do not decode
// (a required closed value it does not know, a wrong JSON kind) make `initialize` answer
// InvalidParams with the decoder's message, and the server stays uninitialized.

// ---- the executable ---------------------------------------------------------------------

// The server's executable: `tools` starts the compiler, `compiler` names it.
type LspServer {
  tools: Launcher
  compiler: Setting
  executable: Text
}

// Serves standard input and output until `exit` or the end of input; exit status 0 after
// `shutdown`, else 1 (LSP 3.17, "Exit Notification").
fn LspServer.main(self: LspServer) -> Result<Unit, IoError> {
  let checker = Checker { tools = self.tools, program = self.compiler.value() }
  let code = LanguageServer.serve(Standard, checker, JsonRpcLimits {})?
  if code != 0 {
    Process.exit(code)?
  }
  Ok(())
}

system IgniteLsp {
  resource tools: Launcher { maximum_children = 4 }
  resource compiler: Setting { flag = "--ignite", default = "ignite" }

  component server: LspServer {
    tools = tools
    compiler = compiler
    executable = "ignite-lsp"
  }
}

// ---- transport --------------------------------------------------------------------------

// Where messages come from and go to: standard input and output, or one end of an in-process
// pipe (the tests).
enum Wire {
  Piped(PipeStream)
  Standard
}

fn wire_read(wire: Wire) -> Result<Input, IoError> requires [wire.*, stdin.read] = match wire {
  Piped(stream) => stream.read(READ_SIZE)
  Standard => Stdin.read(READ_SIZE)
}

fn wire_write(wire: Wire, bytes: Bytes) -> Result<Unit, IoError> requires [wire.*, stdout.write] = match wire {
  Piped(stream) => stream.write_all(bytes)
  Standard => Stdout.write_all(bytes)
}

fn wire_close(wire: Wire) -> Result<Unit, IoError> requires [wire.*] = match wire {
  Piped(stream) => stream.close()
  Standard => Ok(())
}

// What comes next on the wire: a message body and the bytes read after it; a body over the
// limit, of this many bytes, read past, and the bytes after it; the end of input between
// messages; or a framing error, after which the input cannot be read further.
enum Incoming {
  Body(Bytes, Bytes)
  Skipped(Int, Bytes)
  Ended
  Broken(FrameError)
}

// The next message on `wire` under `limits`, after the bytes already read in `buffer`, framed
// by `std.protocol.jsonrpc` (`split_frame`). A body over the limit whose header is valid is
// read and dropped as it arrives, never kept, so the session can go on after it.
fn next_frame(wire: Wire, limits: JsonRpcLimits, buffer: Bytes) -> Result<Incoming, IoError> requires [wire.*, stdin.read] {
  var data = buffer
  loop {
    match split_frame(data, limits) {
      Framed(found) => return match found {
        Got(body, rest) => Ok(Body(body, rest))
        Closed => Ok(Ended)
        Failed(BodyTooLarge) => match header_of(data) {
          Some((end, length)) => skip(wire, data.slice(end, data.len()), length)
          None => Ok(Broken(BodyTooLarge))
        }
        Failed(error) => Ok(Broken(error))
      }
      Partial => {}
    }
    match wire_read(wire)? {
      Eof => return Ok(if data.is_empty() { Ended } else { Broken(Truncated) })
      Data(more) => data.append(more)
    }
  }
}

// The end of the header at the start of `data` and its `Content-Length`, when both are there.
fn header_of(data: Bytes) -> Option<(Int, Int)> = match bytes_find_from(data, b"\r\n\r\n", 0) {
  Some(at) => match content_length(data.slice(0, at).to_text()) {
    Ok(length) => Some((at + 4, length))
    Err(_) => None
  }
  None => None
}

// Reads past a body of `length` bytes on `wire` that starts with `read`, the bytes already
// read after its header.
fn skip(wire: Wire, read: Bytes, length: Int) -> Result<Incoming, IoError> requires [wire.*, stdin.read] {
  var left = length
  var data = read
  loop {
    if data.len() >= left {
      return Ok(Skipped(length, data.slice(left, data.len())))
    }
    left = left - data.len()
    match wire_read(wire)? {
      Eof => return Ok(Broken(Truncated))
      Data(more) => {
        data = more
      }
    }
  }
}

// What a framing error is, for the line the server writes to stderr before it ends.
fn framing(error: FrameError) -> Text = match error {
  MissingLength => "a message header has no Content-Length"
  InvalidLength => "a message header has an invalid Content-Length"
  MalformedHeader => "a message header line is not `Name: value`"
  HeaderTooLarge => "a message header is over its limit"
  BodyTooLarge => "a message body is over its limit"
  Truncated => "the input ended inside a message"
}

// `message` framed with its `Content-Length` header (LSP 3.17, "Header Part").
fn send(wire: Wire, message: Message) -> Result<Unit, IoError> requires [wire.*, stdout.write] satisfies [
  LANGUAGE_SERVER_3_17.RBASE_HEADER_1
] = wire_write(wire, frame(encode_message(message)))

// ---- the session ------------------------------------------------------------------------

// Where the lifecycle is: before `initialize`, between `initialize` and `shutdown`, after
// `shutdown`.
enum Phase {
  Uninitialized
  Running
  ShutDown
}

// The unit of `Position.character`.
enum Encoding {
  Utf8
  Utf16
}

// An open document: its text, the version the client gave it, and whether the text is the
// file's as last opened or saved.
type Buffer {
  text: Text
  version: Int
  saved: Bool = true
}

// The index of a buffer at `version` (none when the compiler gave none), and the last index of
// the buffer that there was, which the outline falls back to.
type Indexed {
  version: Int
  index: Option<Index>
  last: Option<Index>
}

// The session: open buffers; the URIs whose check waits, in the order they changed; the index
// of each buffer; the diagnostics of each buffer's last check without a syntax error; the
// version each buffer's diagnostics were last published for.
type Session {
  phase: Phase
  encoding: Encoding
  buffers: Map<Text, Buffer>
  waiting: List<Text>
  indexes: Map<Text, Indexed>
  typed: Map<Text, List<Diagnostic>>
  published: Map<Text, Int>
}

fn fresh() -> Session = Session {
  phase = Uninitialized
  encoding = Utf16
  buffers = Map.empty()
  waiting = []
  indexes = Map.empty()
  typed = Map.empty()
  published = Map.empty()
}

// What a notification makes the server do besides changing its session.
enum Act {
  Publish(Text)
  Clear(Text)
  Exit(Int)
}

// The `ErrorObject` of an LSP error code.
fn failure(code: ErrorCodes, message: Text) -> ErrorObject = match ErrorCodes.to_json(code) {
  Json.Number(n) => ErrorObject { code = n, message }
  _ => ErrorObject { code = -32603, message }
}

// The encoding of positions: UTF-8 when the client lists it among its `positionEncodings`,
// else UTF-16, which every client supports (LSP 3.17, "Position").
fn negotiate(params: InitializeParams) -> Encoding = match params.capabilities.general {
  Some(general) => match general.position_encodings {
    Some(kinds) => {
      for kind in kinds {
        if kind == PositionEncodingKind.UTF8 {
          return Utf8
        }
      }
      Utf16
    }
    None => Utf16
  }
  None => Utf16
}

fn encoding_kind(encoding: Encoding) -> PositionEncodingKind = match encoding {
  Utf8 => PositionEncodingKind.UTF8
  Utf16 => PositionEncodingKind.UTF16
}

// The result of `initialize`: full text synchronisation with open, close and save, hover,
// definition and document symbols, positions in `encoding`.
fn capabilities(encoding: Encoding) -> InitializeResult = InitializeResult {
  capabilities = ServerCapabilities {
    position_encoding = Some(encoding_kind(encoding))
    text_document_sync = Some(ServerCapabilitiesTextDocumentSync.TextDocumentSyncOptions(TextDocumentSyncOptions {
      open_close = Some(true)
      change = Some(TextDocumentSyncKind.Full)
      save = Some(TextDocumentSyncOptionsSave.Boolean(true))
    }))
    hover_provider = Some(ServerCapabilitiesHoverProvider.Boolean(true))
    definition_provider = Some(ServerCapabilitiesDefinitionProvider.Boolean(true))
    document_symbol_provider = Some(ServerCapabilitiesDocumentSymbolProvider.Boolean(true))
  }
  server_info = Some(InitializeResultServerInfo { name = "ignite-lsp" })
}

fn initialize(session: Session, params: Option<Json>) -> (Session, Result<Json, ErrorObject>) =
  match InitializeParams.from_json(params.unwrap_or(Json.Null)) {
    Ok(decoded) => {
      let encoding = negotiate(decoded)
      let result = InitializeResult.to_json(capabilities(encoding))
      (Session { phase = Running, encoding, ..session }, Ok(result))
    }
    Err(reason) => (session, Err(failure(ErrorCodes.InvalidParams, "initialize params: {reason}")))
  }

// The answer to `request` and the session after it. Before `initialize` every other request
// is ServerNotInitialized; after `shutdown` every request is InvalidRequest; a request the
// server does not implement, `$/` ones included, is MethodNotFound.
fn respond(session: Session, request: Request) -> (Session, Result<Json, ErrorObject>) satisfies [
  LANGUAGE_SERVER_3_17.RBASE_RESPONSE_1, LANGUAGE_SERVER_3_17.RBASE_RESPONSE_2,
  LANGUAGE_SERVER_3_17.RBASE_RESPONSE_6, LANGUAGE_SERVER_3_17.RBASE_DOLLAR_2,
  LANGUAGE_SERVER_3_17.RLIFECYCLE_INITIALIZE_1, LANGUAGE_SERVER_3_17.RLIFECYCLE_INITIALIZE_2,
  LANGUAGE_SERVER_3_17.RLIFECYCLE_SHUTDOWN_3
] = match session.phase {
  Uninitialized => if request.method == METHOD_INITIALIZE {
    initialize(session, request.params)
  } else {
    (session, Err(failure(ErrorCodes.ServerNotInitialized, "the server is not initialized: send initialize first")))
  }
  Running => if request.method == METHOD_INITIALIZE {
    (session, Err(failure(ErrorCodes.InvalidRequest, "initialize was already received")))
  } else if request.method == METHOD_SHUTDOWN {
    (Session { phase = ShutDown, ..session }, Ok(Json.Null))
  } else {
    (session, Err(failure(ErrorCodes.MethodNotFound, "method not found: {request.method}")))
  }
  ShutDown => (session, Err(failure(ErrorCodes.InvalidRequest, "the server is shut down: only exit is accepted")))
}

// The session after `notification` and what the server does about it. Before `initialize`
// only `exit` counts; an unknown notification, `$/cancelRequest` among them, is dropped.
fn on_notification(session: Session, notification: Notification) -> (Session, List<Act>) satisfies [
  LANGUAGE_SERVER_3_17.RBASE_NOTIFICATION_1, LANGUAGE_SERVER_3_17.RBASE_DOLLAR_1,
  LANGUAGE_SERVER_3_17.RLIFECYCLE_INITIALIZE_3, LANGUAGE_SERVER_3_17.RLIFECYCLE_INITIALIZE_5,
  LANGUAGE_SERVER_3_17.RLIFECYCLE_EXIT_1
] {
  let params = notification.params.unwrap_or(Json.Null)
  if notification.method == METHOD_EXIT {
    return (session, [Exit(if session.phase == ShutDown { 0 } else { 1 })])
  }
  if session.phase != Running {
    return (session, [])
  }
  if notification.method == METHOD_TEXT_DOCUMENT_DID_OPEN {
    match DidOpenTextDocumentParams.from_json(params) {
      Ok(opened) => {
        let document = opened.text_document
        var buffers = session.buffers
        buffers.put(document.uri, Buffer { text = document.text, version = document.version })
        (Session { buffers, ..session }, [Publish(document.uri)])
      }
      Err(_) => (session, [])
    }
  } else if notification.method == METHOD_TEXT_DOCUMENT_DID_CHANGE {
    match DidChangeTextDocumentParams.from_json(params) {
      Ok(changed) => {
        let uri = changed.text_document.uri
        match session.buffers.get(uri) {
          Some(buffer) => {
            var buffers = session.buffers
            buffers.put(uri, Buffer { text = replaced(buffer.text, changed.content_changes), version = changed.text_document.version, saved = false })
            (Session { buffers, ..session }, [Publish(uri)])
          }
          None => (session, [])
        }
      }
      Err(_) => (session, [])
    }
  } else if notification.method == METHOD_TEXT_DOCUMENT_DID_CLOSE {
    match DidCloseTextDocumentParams.from_json(params) {
      Ok(closed) => {
        let uri = closed.text_document.uri
        var buffers = session.buffers
        _ = buffers.remove(uri)
        var indexes = session.indexes
        _ = indexes.remove(uri)
        var typed = session.typed
        _ = typed.remove(uri)
        var published = session.published
        _ = published.remove(uri)
        (Session { buffers, indexes, typed, published, waiting = without(session.waiting, uri), ..session }, [Clear(uri)])
      }
      Err(_) => (session, [])
    }
  } else if notification.method == METHOD_TEXT_DOCUMENT_DID_SAVE {
    match DidSaveTextDocumentParams.from_json(params) {
      Ok(saved) => {
        let uri = saved.text_document.uri
        match session.buffers.get(uri) {
          Some(buffer) => {
            var buffers = session.buffers
            buffers.put(uri, Buffer { saved = true, ..buffer })
            var indexes = session.indexes
            match indexes.get(uri) {
              Some(old) => indexes.put(uri, Indexed { version = -1, index = None, last = newest(old) })
              None => {}
            }
            (Session { buffers, indexes, ..session }, [])
          }
          None => (session, [])
        }
      }
      Err(_) => (session, [])
    }
  } else {
    (session, [])
  }
}

// `text` after `changes` under full synchronisation: each whole-document change replaces the
// text. A ranged change is not applied; the server announces `TextDocumentSyncKind.Full`, so
// a client sends none.
fn replaced(text: Text, changes: List<TextDocumentContentChangeEvent>) -> Text {
  var out = text
  for change in changes {
    match change {
      TextDocumentContentChangeEvent.TextDocumentContentChangeEventLiteral2(whole) => {
        out = whole.text
      }
      _ => {}
    }
  }
  out
}

// `uris` without `uri`.
fn without(uris: List<Text>, uri: Text) -> List<Text> {
  var out: List<Text> = []
  for item in uris {
    if item != uri {
      out.push(item)
    }
  }
  out
}

// The newest index `indexed` holds: its own, else the last one before it.
fn newest(indexed: Indexed) -> Option<Index> = match indexed.index {
  Some(index) => Some(index)
  None => indexed.last
}

// ---- diagnostics ------------------------------------------------------------------------

// How the server runs the compiler: `program` with `prefix` before the arguments of
// `ignite check`. The executable passes no prefix; the tests run a shell script in its place.
type Checker {
  tools: Launcher
  program: Text
  prefix: List<Text> = []
}

// The path a document whose URI has none (`untitled:`, another scheme, a remote host) is
// checked under: a file in `/` that is never read, so the buffer still gets its diagnostics
// and a program with a `package` finds no sibling modules.
const STAND_IN_PATH: Text = "/untitled.ignite"

// The file path of a `file:` URI with an empty or a `localhost` authority (RFC 8089 section
// 2), percent-decoded; none for another host or any other scheme.
fn path_of(uri: Text) -> Option<Text> {
  let rest = match uri.strip_prefix("file://") {
    Some(rest) => rest.to_bytes()
    None => return None
  }
  let start = if rest.len() > 0 && rest.at(0) == b'/' {
    0
  } else if rest.len() > 9 && rest.slice(0, 9).to_text().to_lower() == "localhost" && rest.at(9) == b'/' {
    9
  } else {
    return None
  }
  let bytes = rest.slice(start, rest.len())
  var out = b""
  var at = 0
  while at < bytes.len() {
    let b = bytes.at(at)
    if b == b'%' && at + 2 < bytes.len() {
      match (hex_value(bytes.at(at + 1)), hex_value(bytes.at(at + 2))) {
        (Some(high), Some(low)) => match (high * 16 + low).to_byte() {
          Some(decoded) => {
            out.push(decoded)
            at = at + 3
            continue
          }
          None => {}
        }
        _ => {}
      }
    }
    out.push(b)
    at = at + 1
  }
  Some(out.to_text())
}

fn hex_value(b: Byte) -> Option<Int> {
  let n = b.to_int()
  if n >= 48 && n <= 57 {
    Some(n - 48)
  } else if n >= 65 && n <= 70 {
    Some(n - 55)
  } else if n >= 97 && n <= 102 {
    Some(n - 87)
  } else {
    None
  }
}

// The byte offset of each line's start in `bytes`: 0, then the byte after each LF, CR LF or
// lone CR. One pass; the positions of a check's diagnostics are looked up in it.
fn line_starts(bytes: Bytes) -> List<Int> {
  var starts = [0]
  let size = bytes.len()
  var at = 0
  while at < size {
    let b = bytes.at(at)
    if b == b'\n' || (b == b'\r' && !(at + 1 < size && bytes.at(at + 1) == b'\n')) {
      starts.push(at + 1)
    }
    at = at + 1
  }
  starts
}

// The position of byte `offset` of `bytes`, whose lines start at `starts` (`line_starts`):
// its line, found by binary search, and its character, counted in `encoding`'s units from the
// line's start: bytes for UTF-8, UTF-16 code units otherwise (one for a character of one to
// three UTF-8 bytes, two for one of four). An offset past the end is the end.
fn position_in(bytes: Bytes, starts: List<Int>, offset: Int, encoding: Encoding) -> Position {
  let end = if offset > bytes.len() { bytes.len() } else if offset < 0 { 0 } else { offset }
  var low = 0
  var high = starts.len() - 1
  while low < high {
    let middle = (low + high + 1) / 2
    if starts.at(middle) <= end {
      low = middle
    } else {
      high = middle - 1
    }
  }
  Position { line = low, character = units(bytes, starts.at(low), end, encoding) }
}

// The position of byte `offset` of `text` (`position_in`).
fn position_at(text: Text, offset: Int, encoding: Encoding) -> Position {
  let bytes = text.to_bytes()
  position_in(bytes, line_starts(bytes), offset, encoding)
}

fn units(bytes: Bytes, from: Int, to: Int, encoding: Encoding) -> Int = match encoding {
  Utf8 => to - from
  Utf16 => {
    var count = 0
    var at = from
    while at < to {
      let n = bytes.at(at).to_int()
      if n < 128 || (n >= 192 && n < 240) {
        count = count + 1
      } else if n >= 240 {
        count = count + 2
      }
      at = at + 1
    }
    count
  }
}

// The byte offset of `position` in `bytes`, whose lines start at `starts`: the inverse of
// `position_in`. A line past the last is the end; a character past its line's end is that end;
// a character inside a UTF-8 sequence is the sequence's start.
fn offset_in(bytes: Bytes, starts: List<Int>, position: Position, encoding: Encoding) -> Int {
  if position.line < 0 {
    return 0
  }
  if position.line >= starts.len() {
    return bytes.len()
  }
  let from = starts[position.line]
  let limit = if position.line + 1 < starts.len() { starts[position.line + 1] } else { bytes.len() }
  var at = from
  var count = 0
  while at < limit && count < position.character {
    let n = bytes.at(at).to_int()
    let size = if n < 128 { 1 } else if n >= 240 { 4 } else if n >= 224 { 3 } else if n >= 192 { 2 } else { 1 }
    let step = match encoding {
      Utf8 => size
      Utf16 => if size == 4 { 2 } else { 1 }
    }
    if count + step > position.character {
      return at
    }
    count = count + step
    at = at + size
  }
  if at > limit { limit } else { at }
}

fn is_blank(b: Byte) -> Bool = b == b' ' || b == b'\t' || b == b'\n' || b == b'\r'

fn is_word_byte(b: Byte) -> Bool = match b {
  b'a'..=b'z' | b'A'..=b'Z' | b'0'..=b'9' | b'_' => true
  _ => false
}

// The bytes `start` to `end` of `bytes` widened when empty, so a client draws them: to the
// identifier at `start`, else to the one character there; at a line's end or the end of the
// text (an E002), back to the last character that is not blank before it. A text with no such
// character keeps the empty range.
fn widened(bytes: Bytes, start: Int, end: Int) -> (Int, Int) {
  if end > start {
    return (start, end)
  }
  let size = bytes.len()
  if start >= 0 && start < size && !is_blank(bytes.at(start)) {
    var stop = start + 1
    if is_word_byte(bytes.at(start)) {
      while stop < size && is_word_byte(bytes.at(stop)) {
        stop = stop + 1
      }
    } else {
      while stop < size && bytes.at(stop).to_int() >= 128 && bytes.at(stop).to_int() < 192 {
        stop = stop + 1
      }
    }
    return (start, stop)
  }
  var back = if start > size { size - 1 } else { start - 1 }
  while back >= 0 && is_blank(bytes.at(back)) {
    back = back - 1
  }
  if back < 0 {
    return (start, end)
  }
  var first = back
  while first > 0 && bytes.at(first).to_int() >= 128 && bytes.at(first).to_int() < 192 {
    first = first - 1
  }
  (first, back + 1)
}

// `diagnostic` with an empty range widened (`widened`) in `bytes`.
fn visible(diagnostic: Diagnostic, bytes: Bytes, starts: List<Int>, encoding: Encoding) -> Diagnostic {
  if diagnostic.range.start != diagnostic.range.end {
    return diagnostic
  }
  let at = offset_in(bytes, starts, diagnostic.range.start, encoding)
  let (start, end) = widened(bytes, at, at)
  Diagnostic { range = Range { start = position_in(bytes, starts, start, encoding), end = position_in(bytes, starts, end, encoding) }, ..diagnostic }
}

// Whether `diagnostic` is a syntax error of the compiler, after which it reports nothing else.
fn is_syntax(diagnostic: Diagnostic) -> Bool =
  diagnostic.code == Some(DiagnosticCode.String("E001")) || diagnostic.code == Some(DiagnosticCode.String("E002"))

// `diagnostic` of an earlier check, shown beside a syntax error.
fn stale(diagnostic: Diagnostic) -> Diagnostic =
  Diagnostic { severity = Some(DiagnosticSeverity.Warning), message = "(before the syntax error) " + diagnostic.message, ..diagnostic }

// The byte `offset` of the position member `name` of a diagnostic record.
fn offset_of(item: Json, name: Text) -> Option<Int> = match item.get(name) {
  Some(position) => position.int("offset")
  None => None
}

// One diagnostic of `ignite check --json`'s output: a record of the checked file at its
// range, one of another file (a sibling module or the standard library) at the document's
// start with that file's path in front of its message. `bytes` is the checked text, `starts`
// its `line_starts`.
fn diagnostic_of(item: Json, path: Text, bytes: Bytes, starts: List<Int>, encoding: Encoding) -> Option<Diagnostic> {
  let (code, message, file) = match (item.text("code"), item.text("message"), item.text("path")) {
    (Some(code), Some(message), Some(file)) => (code, message, file)
    _ => return None
  }
  let range = if file == path {
    match (offset_of(item, "start"), offset_of(item, "end")) {
      (Some(start), Some(end)) => Range { start = position_in(bytes, starts, start, encoding), end = position_in(bytes, starts, end, encoding) }
      _ => return None
    }
  } else {
    Range { start = Position { line = 0, character = 0 }, end = Position { line = 0, character = 0 } }
  }
  Some(Diagnostic {
    range
    severity = Some(DiagnosticSeverity.Error)
    code = Some(DiagnosticCode.String(code))
    source = Some("ignite")
    message = if file == path { message } else { "{file}: {message}" }
  })
}

// A diagnostic at the document's start saying why the compiler gave no diagnostics.
fn trouble(message: Text) -> Diagnostic = Diagnostic {
  range = Range { start = Position { line = 0, character = 0 }, end = Position { line = 0, character = 0 } }
  severity = Some(DiagnosticSeverity.Error)
  source = Some("ignite-lsp")
  message
}

// The diagnostics of `output`, the output of `ignite check --json` for `path`, whose text is
// `text`: one pass over `text` for its line starts, then a lookup per position.
fn diagnostics_in(output: Text, path: Text, text: Text, encoding: Encoding) -> List<Diagnostic> {
  let items = match parse(output) {
    Ok(value) => match value.get("diagnostics") {
      Some(Json.Array(items)) => items
      _ => return [trouble("ignite check printed no diagnostics list")]
    }
    Err(_) => return [trouble("ignite check printed no JSON")]
  }
  let bytes = text.to_bytes()
  let starts = line_starts(bytes)
  var out = []
  for item in items {
    match diagnostic_of(item, path, bytes, starts, encoding) {
      Some(diagnostic) => out.push(diagnostic)
      None => {}
    }
  }
  out
}

// `text` checked as the file at `path` by `checker`: the buffer is the compiler's stdin. Its
// output is kept up to `Launcher`'s largest limit, 16 MiB (about 60,000 diagnostics); an
// output cut there is one diagnostic saying so.
fn check(checker: Checker, path: Text, text: Text, encoding: Encoding) -> List<Diagnostic> requires [checker.*] {
  var arguments = checker.prefix
  arguments.append(["check", "--json", "--stdin-for", path])
  let limit = 16 MiB
  let invocation = Invocation { program = checker.program, arguments, input = text.to_bytes(), timeout = 30 seconds, output_limit = limit }
  match checker.tools.execute(invocation) {
    Ok(exit) => if exit.dropped > 0 && exit.stdout.len() >= limit.to_int() {
      [trouble("ignite check printed more than 16 MiB; {exit.dropped} bytes were dropped, so its diagnostics are lost")]
    } else if exit.ending == 0 && (exit.code == 0 || exit.code == 1) {
      diagnostics_in(exit.stdout.to_text(), path, text, encoding)
    } else {
      [trouble("ignite check ended with {exit.ending}/{exit.code}: {exit.stderr.to_text()}")]
    }
    Err(error) => [trouble("ignite check did not run: {error.message}")]
  }
}

fn publish(wire: Wire, uri: Text, version: Option<Int>, diagnostics: List<Diagnostic>) -> Result<Unit, IoError> requires [wire.*, stdout.write] {
  let params = PublishDiagnosticsParams { uri, version, diagnostics }
  send(wire, Notify(Notification { method = METHOD_TEXT_DOCUMENT_PUBLISH_DIAGNOSTICS, params = Some(PublishDiagnosticsParams.to_json(params)) }))
}

// The session after `uri`, open as `open`, is checked and its diagnostics published: with a
// syntax error, the type errors of its last check without one beside it (`stale`); every
// empty range widened. A version older than the one last published is not published.
fn diagnose(wire: Wire, checker: Checker, state: Session, uri: Text, open: Buffer) -> Result<Session, IoError> requires [wire.*, stdout.write, checker.*] {
  if state.published.get(uri).unwrap_or(-1) > open.version {
    return Ok(state)
  }
  let path = path_of(uri).unwrap_or(STAND_IN_PATH)
  let found = check(checker, path, open.text, state.encoding)
  var syntax = false
  var troubled = false
  for diagnostic in found {
    if is_syntax(diagnostic) {
      syntax = true
    }
    if diagnostic.source != Some("ignite") {
      troubled = true
    }
  }
  var typed = state.typed
  var shown = found
  if syntax {
    shown.append(typed.get(uri).unwrap_or([]).map(stale))
  } else if !troubled {
    typed.put(uri, found)
  }
  let bytes = open.text.to_bytes()
  let starts = line_starts(bytes)
  let encoding = state.encoding
  publish(wire, uri, Some(open.version), shown.map(|d| visible(d, bytes, starts, encoding)))?
  var published = state.published
  published.put(uri, open.version)
  Ok(Session { typed, published, ..state })
}

// The session after every waiting buffer is checked, in the order they changed.
fn settle(wire: Wire, checker: Checker, state: Session) -> Result<Session, IoError> requires [wire.*, stdout.write, checker.*] {
  var next = Session { waiting = [], ..state }
  for uri in state.waiting {
    match next.buffers.get(uri) {
      Some(open) => {
        next = diagnose(wire, checker, next, uri, open)?
      }
      None => {}
    }
  }
  Ok(next)
}

// ---- hover, definition, outline ---------------------------------------------------------

// Whether `method` is answered from the typed index.
fn is_query(method: Text) -> Bool =
  method == METHOD_TEXT_DOCUMENT_HOVER || method == METHOD_TEXT_DOCUMENT_DEFINITION || method == METHOD_TEXT_DOCUMENT_DOCUMENT_SYMBOL

// The index of `buffer`, the document at `uri`, from `ignite emit --typed-json`: on the file
// when the buffer is as saved, else, or when the file gave none (an editor can open a buffer
// that differs from its file), on `/dev/stdin` with the buffer as the child's input.
fn index(checker: Checker, uri: Text, buffer: Buffer) -> Option<Index> requires [checker.*] {
  match path_of(uri) {
    Some(file) => if buffer.saved {
      match emitted(checker, file, Bytes.empty(), buffer.text) {
        Some(found) => return Some(found)
        None => {}
      }
    }
    None => {}
  }
  emitted(checker, "/dev/stdin", buffer.text.to_bytes(), buffer.text)
}

// The index of `text` from `ignite emit --typed-json PATH` with `input` on the child's stdin.
fn emitted(checker: Checker, path: Text, input: Bytes, text: Text) -> Option<Index> requires [checker.*] {
  var arguments = checker.prefix
  arguments.append(["emit", "--typed-json", path])
  let invocation = Invocation { program = checker.program, arguments, input, timeout = 30 seconds, output_limit = 16 MiB }
  match checker.tools.execute(invocation) {
    Ok(exit) => if exit.ending == 0 && exit.code == 0 && exit.dropped == 0 { index_of_output(exit.stdout.to_text(), text) } else { None }
    Err(_) => None
  }
}

// The session with the index of `uri`'s current version, built when it has none, and that
// entry.
fn indexed(checker: Checker, state: Session, uri: Text, buffer: Buffer) -> (Session, Indexed) requires [checker.*] {
  let before = state.indexes.get(uri)
  match before {
    Some(known) => if known.version == buffer.version {
      return (state, known)
    }
    None => {}
  }
  let built = index(checker, uri, buffer)
  let last = match built {
    Some(found) => Some(found)
    None => match before {
      Some(known) => newest(known)
      None => None
    }
  }
  let entry = Indexed { version = buffer.version, index = built, last }
  var indexes = state.indexes
  indexes.put(uri, entry)
  (Session { indexes, ..state }, entry)
}

fn range_of(span: Span, bytes: Bytes, starts: List<Int>, encoding: Encoding) -> Range =
  Range { start = position_in(bytes, starts, span.start, encoding), end = position_in(bytes, starts, span.end, encoding) }

fn symbol_of(entry: Entry, bytes: Bytes, starts: List<Int>, encoding: Encoding) -> DocumentSymbol = DocumentSymbol {
  name = if entry.name.is_empty() { "_" } else { entry.name }
  detail = if entry.detail.is_empty() { None } else { Some(entry.detail) }
  kind = entry.kind
  range = range_of(entry.whole, bytes, starts, encoding)
  selection_range = range_of(entry.selection, bytes, starts, encoding)
  children = if entry.children.is_empty() { None } else { Some(entry.children.map(|child| symbol_of(child, bytes, starts, encoding))) }
}

// The answer to a hover, definition or documentSymbol request and the session after it: null
// for a document that is not open or has no index, or a position with nothing to show; the
// outline falls back to the buffer's last index while the current version has none.
fn query(checker: Checker, state: Session, request: Request) -> (Session, Result<Json, ErrorObject>) requires [checker.*] {
  let params = request.params.unwrap_or(Json.Null)
  let (uri, position) = if request.method == METHOD_TEXT_DOCUMENT_HOVER {
    match HoverParams.from_json(params) {
      Ok(decoded) => (decoded.text_document.uri, Some(decoded.position))
      Err(reason) => return (state, Err(failure(ErrorCodes.InvalidParams, "{request.method} params: {reason}")))
    }
  } else if request.method == METHOD_TEXT_DOCUMENT_DEFINITION {
    match DefinitionParams.from_json(params) {
      Ok(decoded) => (decoded.text_document.uri, Some(decoded.position))
      Err(reason) => return (state, Err(failure(ErrorCodes.InvalidParams, "{request.method} params: {reason}")))
    }
  } else {
    match DocumentSymbolParams.from_json(params) {
      Ok(decoded) => (decoded.text_document.uri, None)
      Err(reason) => return (state, Err(failure(ErrorCodes.InvalidParams, "{request.method} params: {reason}")))
    }
  }
  let buffer = match state.buffers.get(uri) {
    Some(open) => open
    None => return (state, Ok(Json.Null))
  }
  let (next, entry) = indexed(checker, state, uri, buffer)
  let bytes = buffer.text.to_bytes()
  let starts = line_starts(bytes)
  let encoding = next.encoding
  let answer = match position {
    None => match newest(entry) {
      Some(found) => TextDocumentDocumentSymbolResult.to_json(TextDocumentDocumentSymbolResult.DocumentSymbolList(found.outline.map(|e| symbol_of(e, bytes, starts, encoding))))
      None => Json.Null
    }
    Some(at) => match entry.index.and_then(|found| spot_at(found, offset_in(bytes, starts, at, encoding))) {
      Some(spot) => if request.method == METHOD_TEXT_DOCUMENT_HOVER {
        let contents = HoverContents.MarkupContent(MarkupContent { kind = MarkupKind.Markdown, value = "```ignite\n" + spot.hover + "\n```" })
        Hover.to_json(Hover { contents, range = Some(range_of(spot.at, bytes, starts, encoding)) })
      } else {
        match spot.target {
          Some(target) => TextDocumentDefinitionResult.to_json(TextDocumentDefinitionResult.Definition(Definition.Location(Location { uri, range = range_of(target, bytes, starts, encoding) })))
          None => Json.Null
        }
      }
      None => Json.Null
    }
  }
  (next, Ok(answer))
}

// ---- the protocol -----------------------------------------------------------------------

// Claims (`docs/slice.md` 19.19): the base protocol and the lifecycle of LSP 3.17 for the
// parties a server is; the Client's requirements are out of scope.
protocol LanguageServer conforms [LANGUAGE_SERVER_3_17] scope { parties = [Server, Sender, Recipient, Any] } {
  unsupported LANGUAGE_SERVER_3_17.RBASE_CONTENT_1 "Content-Type is read and ignored: a header naming another charset is not answered with an error"
  not_applicable LANGUAGE_SERVER_3_17.RBASE_CONTENT_2 "Content-Type is not read: every body is read as UTF-8"
  not_applicable LANGUAGE_SERVER_3_17.RBASE_RESPONSE_5 "addresses the authors of error codes: the server defines none of its own"
  not_applicable LANGUAGE_SERVER_3_17.RBASE_RESPONSE_7 "the server never sends ServerCancelled"
  not_applicable LANGUAGE_SERVER_3_17.RBASE_RESPONSE_8 "the server never sends ContentModified"
  not_applicable LANGUAGE_SERVER_3_17.RBASE_CANCEL_2 "no request is cancelled: each is answered before the next message is read"
  unsupported LANGUAGE_SERVER_3_17.RLIFECYCLE_INITIALIZE_6 "the server reports no progress"
  not_applicable LANGUAGE_SERVER_3_17.RLIFECYCLE_REGISTER_1 "the server registers no capability dynamically"
  not_applicable LANGUAGE_SERVER_3_17.RLIFECYCLE_REGISTER_2 "the server registers no capability dynamically"
  not_applicable LANGUAGE_SERVER_3_17.RLIFECYCLE_LOGTRACE_1 "the server sends no $/logTrace"
  not_applicable LANGUAGE_SERVER_3_17.RLIFECYCLE_LOGTRACE_2 "the server sends no $/logTrace"
  unsupported LANGUAGE_SERVER_3_17.RLIFECYCLE_LOGTRACE_3 "the server sends no $/logTrace"
  unsupported LANGUAGE_SERVER_3_17.RLIFECYCLE_LOGTRACE_4 "the server sends no window/logMessage"

  // Server role: read messages from `wire` until `exit` or the end of input, answer every
  // request, act on the notifications, run `checker` on each opened or changed document and
  // publish its diagnostics. Messages are bounded by `limits`: a body over its limit is read
  // past and answered with InvalidRequest under a null id; any other framing error is one
  // line on stderr and the end. The exit status: 0 after `shutdown`, else 1; the wire is
  // closed.
  fn serve(wire: Wire, checker: Checker, limits: JsonRpcLimits) -> Result<Int, IoError> requires [wire.*, stdin.read, stdout.write, checker.*] satisfies [
    LANGUAGE_SERVER_3_17.RBASE_REQUEST_1, LANGUAGE_SERVER_3_17.RBASE_RESPONSE_3,
    LANGUAGE_SERVER_3_17.RBASE_RESPONSE_4, LANGUAGE_SERVER_3_17.RBASE_CANCEL_1
  ] {
    let code = session(wire, checker, limits)
    _ = wire_close(wire)
    code
  }
}

fn session(wire: Wire, checker: Checker, limits: JsonRpcLimits) -> Result<Int, IoError> requires [wire.*, stdin.read, stdout.write, checker.*] {
  var state = fresh()
  var buffer = Bytes.empty()
  loop {
    if buffer.is_empty() && !state.waiting.is_empty() {
      state = settle(wire, checker, state)?
    }
    match next_frame(wire, limits, buffer)? {
      Body(body, rest) => {
        buffer = rest
        match decode_body(body) {
          Ok(Call(request)) => {
            let (next, outcome) = if state.phase == Running && is_query(request.method) {
              query(checker, state, request)
            } else {
              respond(settle(wire, checker, state)?, request)
            }
            state = next
            send(wire, Reply(Response { id = Some(request.id), outcome }))?
          }
          Ok(Notify(notification)) => {
            let (next, exit) = notified(wire, state, notification)?
            state = next
            match exit {
              Some(code) => return Ok(code)
              None => {}
            }
          }
          Ok(Reply(_)) => {}
          Err(error) => match notification_batch(body) {
            Some(notifications) => {
              for notification in notifications {
                let (next, exit) = notified(wire, state, notification)?
                state = next
                match exit {
                  Some(code) => return Ok(code)
                  None => {}
                }
              }
            }
            None => send(wire, Reply(Response { id = detected_id(body), outcome = Err(error) }))?
          }
        }
      }
      Skipped(length, rest) => {
        buffer = rest
        let message = "a message body of {length} bytes is over the limit of {limits.body.to_int()} bytes"
        log("ignite-lsp: {message}: skipped")
        send(wire, Reply(Response { id = None, outcome = Err(failure(ErrorCodes.InvalidRequest, message)) }))?
      }
      Ended => return Ok(if state.phase == ShutDown { 0 } else { 1 })
      Broken(error) => {
        log("ignite-lsp: {framing(error)}; the input cannot be read further, exiting")
        return Ok(1)
      }
    }
  }
}

// The session after `notification` and its acts done: each opened or changed document put
// last among those whose check waits (`settle` checks them), a closed one.s diagnostics
// cleared; the exit status when it is `exit`.
fn notified(wire: Wire, state: Session, notification: Notification) -> Result<(Session, Option<Int>), IoError> requires [wire.*, stdout.write] {
  let (after, acts) = on_notification(state, notification)
  var next = after
  for act in acts {
    match act {
      Publish(uri) => {
        var waiting = without(next.waiting, uri)
        waiting.push(uri)
        next = Session { waiting, ..next }
      }
      Clear(uri) => publish(wire, uri, None, [])?
      Exit(code) => return Ok((next, Some(code)))
    }
  }
  Ok((next, None))
}

// ---- tests ------------------------------------------------------------------------------

// A connected pair of pipe ends; each gives up on a peer silent for 5 s.
test fn connected() -> Result<(PipeStream, PipeStream), IoError> {
  let (client, server) = Pipe.pair()
  client.set_idle_timeout(5000)?
  server.set_idle_timeout(5000)?
  Ok((client, server))
}

// A checker that runs no compiler: a shell script that reads the buffer from stdin and, when
// it holds `broken`, prints one E040 at bytes `start` to `end` of the path it was given, else
// no diagnostic.
test fn script(start: Int, end: Int) -> Checker = Checker {
  tools = Launcher.new()
  program = "/bin/sh"
  prefix = [
    "-c",
    r#"if grep -q broken; then printf '{"diagnostics":[{"code":"E040","end":{"column":1,"line":1,"offset":%s},"message":"type mismatch","path":"%s","start":{"column":1,"line":1,"offset":%s}}]}\n' "$1" "$5" "$0"; else printf '{"diagnostics":[]}\n'; fi"#,
    start.to_text(),
    end.to_text()
  ]
}

// The bodies `client` reads until the server closes its end.
test fn replies_of(client: PipeStream) -> Result<List<Text>, IoError> {
  var replies = []
  var buffer = Bytes.empty()
  loop {
    match read_message(client, JsonRpcLimits {}, buffer)? {
      Got(body, rest) => {
        replies.push(body.to_text())
        buffer = rest
      }
      _ => return Ok(replies)
    }
  }
}

// `bodies` sent as framed messages to a server on a pipe with `checker`, then the end of
// input: the server's exit status and every body it wrote.
test fn exchange(bodies: List<Text>, checker: Checker) -> Result<(Int, List<Text>), IoError> {
  var input = Bytes.empty()
  for body in bodies {
    input.append(frame(body))
  }
  exchange_bytes(input, JsonRpcLimits {}, checker)
}

// `input` sent as it is to a server on a pipe with `limits` and `checker`, then the end of
// input: the server's exit status and every body it wrote.
test fn exchange_bytes(input: Bytes, limits: JsonRpcLimits, checker: Checker) -> Result<(Int, List<Text>), IoError> {
  let (client, server) = connected()?
  client.write_all(input)?
  _ = client.close()
  let code = LanguageServer.serve(Piped(server), checker, limits)?
  Ok((code, replies_of(client)?))
}

test fn quiet() -> Checker = script(0, 0)

test const INITIALIZE: Text = r#"{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"processId":null,"rootUri":null,"capabilities":{}}}"#
test const INITIALIZED: Text = r#"{"jsonrpc":"2.0","method":"initialized","params":{}}"#
test const SHUTDOWN: Text = r#"{"jsonrpc":"2.0","id":2,"method":"shutdown"}"#
test const EXIT: Text = r#"{"jsonrpc":"2.0","method":"exit"}"#

test const CAPABILITIES_UTF16: Text = r#"{"jsonrpc":"2.0","id":1,"result":{"capabilities":{"positionEncoding":"utf-16","textDocumentSync":{"openClose":true,"change":1,"save":true},"hoverProvider":true,"definitionProvider":true,"documentSymbolProvider":true},"serverInfo":{"name":"ignite-lsp"}}}"#

test "initialize, initialized, shutdown and exit get the replies the specification requires, exit 0" verifies [
  LANGUAGE_SERVER_3_17.RBASE_HEADER_1, LANGUAGE_SERVER_3_17.RBASE_REQUEST_1,
  LANGUAGE_SERVER_3_17.RBASE_RESPONSE_1, LANGUAGE_SERVER_3_17.RBASE_RESPONSE_2,
  LANGUAGE_SERVER_3_17.RBASE_RESPONSE_3, LANGUAGE_SERVER_3_17.RLIFECYCLE_EXIT_1
] {
  let (code, replies) = exchange([INITIALIZE, INITIALIZED, SHUTDOWN, EXIT], quiet())?
  assert code == 0
  assert replies == [CAPABILITIES_UTF16, r#"{"jsonrpc":"2.0","id":2,"result":null}"#]
}

test "exit without shutdown ends with status 1, before and after initialize" verifies [
  LANGUAGE_SERVER_3_17.RLIFECYCLE_EXIT_1, LANGUAGE_SERVER_3_17.RLIFECYCLE_INITIALIZE_3
] {
  let (initialized, replies) = exchange([INITIALIZE, INITIALIZED, EXIT], quiet())?
  assert initialized == 1
  assert replies == [CAPABILITIES_UTF16]
  let (early, none) = exchange([EXIT], quiet())?
  assert early == 1
  assert none == []
}

test "the end of input without exit is status 0 after shutdown, else 1" {
  let (after, _) = exchange([INITIALIZE, SHUTDOWN], quiet())?
  assert after == 0
  let (before, _) = exchange([INITIALIZE], quiet())?
  assert before == 1
}

test "a request before initialize gets -32002 and a notification is dropped" verifies [
  LANGUAGE_SERVER_3_17.RLIFECYCLE_INITIALIZE_1, LANGUAGE_SERVER_3_17.RLIFECYCLE_INITIALIZE_2,
  LANGUAGE_SERVER_3_17.RLIFECYCLE_INITIALIZE_3, LANGUAGE_SERVER_3_17.RLIFECYCLE_INITIALIZE_5,
  LANGUAGE_SERVER_3_17.RBASE_RESPONSE_4, LANGUAGE_SERVER_3_17.RBASE_RESPONSE_6
] {
  let open = r#"{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file:///w/a.ignite","languageId":"ignite","version":1,"text":"broken"}}}"#
  let (code, replies) = exchange([SHUTDOWN, open, INITIALIZE, EXIT], script(0, 1))?
  assert code == 1
  assert replies == [
    r#"{"jsonrpc":"2.0","id":2,"error":{"code":-32002,"message":"the server is not initialized: send initialize first"}}"#,
    CAPABILITIES_UTF16
  ]
}

test "an unknown request gets -32601, a $/ one too, and an unknown notification is ignored" verifies [
  LANGUAGE_SERVER_3_17.RBASE_DOLLAR_1, LANGUAGE_SERVER_3_17.RBASE_DOLLAR_2,
  LANGUAGE_SERVER_3_17.RBASE_NOTIFICATION_1, LANGUAGE_SERVER_3_17.RBASE_RESPONSE_4
] {
  let (code, replies) = exchange([
    INITIALIZE,
    r#"{"jsonrpc":"2.0","id":7,"method":"textDocument/completion","params":{}}"#,
    r#"{"jsonrpc":"2.0","method":"workspace/didChangeConfiguration","params":{"settings":{}}}"#,
    r#"{"jsonrpc":"2.0","method":"$/setTrace","params":{"value":"off"}}"#,
    r#"{"jsonrpc":"2.0","id":"x","method":"$/unknown"}"#,
    SHUTDOWN,
    EXIT
  ], quiet())?
  assert code == 0
  assert replies == [
    CAPABILITIES_UTF16,
    r#"{"jsonrpc":"2.0","id":7,"error":{"code":-32601,"message":"method not found: textDocument/completion"}}"#,
    r#"{"jsonrpc":"2.0","id":"x","error":{"code":-32601,"message":"method not found: $/unknown"}}"#,
    r#"{"jsonrpc":"2.0","id":2,"result":null}"#
  ]
}

test "a request after shutdown is InvalidRequest, a second initialize too" verifies [
  LANGUAGE_SERVER_3_17.RLIFECYCLE_SHUTDOWN_3
] {
  let (code, replies) = exchange([
    INITIALIZE,
    r#"{"jsonrpc":"2.0","id":3,"method":"initialize","params":{"processId":null,"rootUri":null,"capabilities":{}}}"#,
    SHUTDOWN,
    r#"{"jsonrpc":"2.0","id":4,"method":"textDocument/completion","params":{}}"#,
    EXIT
  ], quiet())?
  assert code == 0
  assert replies == [
    CAPABILITIES_UTF16,
    r#"{"jsonrpc":"2.0","id":3,"error":{"code":-32600,"message":"initialize was already received"}}"#,
    r#"{"jsonrpc":"2.0","id":2,"result":null}"#,
    r#"{"jsonrpc":"2.0","id":4,"error":{"code":-32600,"message":"the server is shut down: only exit is accepted"}}"#
  ]
}

test "a cancelled request is still answered" verifies [LANGUAGE_SERVER_3_17.RBASE_CANCEL_1] {
  let (_, replies) = exchange([
    INITIALIZE,
    SHUTDOWN,
    r#"{"jsonrpc":"2.0","method":"$/cancelRequest","params":{"id":2}}"#,
    EXIT
  ], quiet())?
  assert replies == [CAPABILITIES_UTF16, r#"{"jsonrpc":"2.0","id":2,"result":null}"#]
}

test "utf-8 is negotiated when the client offers it, else utf-16" {
  let offered = r#"{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"processId":null,"rootUri":null,"capabilities":{"general":{"positionEncodings":["utf-32","utf-8","utf-16"]}}}}"#
  let (_, utf8) = exchange([offered, EXIT], quiet())?
  assert utf8 == [r#"{"jsonrpc":"2.0","id":1,"result":{"capabilities":{"positionEncoding":"utf-8","textDocumentSync":{"openClose":true,"change":1,"save":true},"hoverProvider":true,"definitionProvider":true,"documentSymbolProvider":true},"serverInfo":{"name":"ignite-lsp"}}}"#]
  let only16 = r#"{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"processId":null,"rootUri":null,"capabilities":{"general":{"positionEncodings":["utf-16"]}}}}"#
  let (_, utf16) = exchange([only16, EXIT], quiet())?
  assert utf16 == [CAPABILITIES_UTF16]
}

// Closed-enumeration tolerance: `DiagnosticTag` lists 1 and 2, `SymbolKind` 1 to 26; a
// `valueSet` with a value 3.17 does not define still initializes.
test "an initialize whose valueSet names unknown values of a closed enumeration still succeeds" {
  let newer = r#"{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"processId":null,"rootUri":null,"capabilities":{"textDocument":{"publishDiagnostics":{"tagSupport":{"valueSet":[1,2,3]}},"documentSymbol":{"symbolKind":{"valueSet":[1,26,27,99]}}}}}}"#
  let (_, replies) = exchange([newer, EXIT], quiet())?
  assert replies == [CAPABILITIES_UTF16]
}

// `failureHandling` (FailureHandlingKind), `prepareSupportDefaultBehavior`
// (PrepareSupportDefaultBehavior, only 1) and `trace` (TraceValues) are optional closed
// enumerations: a value 3.17 does not define is decoded as absent.
test "an initialize with an unknown value of an optional closed enumeration still succeeds" {
  let failure = r#"{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"processId":null,"rootUri":null,"capabilities":{"workspace":{"workspaceEdit":{"failureHandling":"retry"}}}}}"#
  let (_, first) = exchange([failure, EXIT], quiet())?
  assert first == [CAPABILITIES_UTF16]
  let rename = r#"{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"processId":null,"rootUri":null,"capabilities":{"textDocument":{"rename":{"prepareSupportDefaultBehavior":2}}}}}"#
  let (_, second) = exchange([rename, EXIT], quiet())?
  assert second == [CAPABILITIES_UTF16]
  let trace = r#"{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"processId":null,"rootUri":null,"capabilities":{},"trace":"bogus"}}"#
  let (_, third) = exchange([trace, EXIT], quiet())?
  assert third == [CAPABILITIES_UTF16]
}

test "an initialize whose params do not decode is InvalidParams and the server stays uninitialized" {
  let wrong = r#"{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"processId":"x","rootUri":null,"capabilities":{}}}"#
  let (code, replies) = exchange([wrong, SHUTDOWN, EXIT], quiet())?
  assert code == 1
  assert replies.len() == 2
  assert replies[0].starts_with(r#"{"jsonrpc":"2.0","id":1,"error":{"code":-32602,"message":"initialize params: "#)
  assert replies[1] == r#"{"jsonrpc":"2.0","id":2,"error":{"code":-32002,"message":"the server is not initialized: send initialize first"}}"#
}

// The session after `notifications`, sent after `initialize`, applied without IO.
test fn after(notifications: List<Text>) -> Result<(Session, List<Act>), Text> {
  var state = fresh()
  let (running, _) = respond(state, Request { id = NumberId(1), method = METHOD_INITIALIZE, params = Some(parse(r#"{"processId":null,"rootUri":null,"capabilities":{}}"#).map_err(|e| e.message)?) })
  state = running
  var acts = []
  for text in notifications {
    match decode_body(text.to_bytes()) {
      Ok(Notify(notification)) => {
        let (next, done) = on_notification(state, notification)
        state = next
        acts.append(done)
      }
      _ => return Err("not a notification: {text}")
    }
  }
  Ok((state, acts))
}

test fn open(uri: Text, version: Int, text: Text) -> Text =
  r#"{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"#.concat(Json.Str(uri).encode()).concat(r#","languageId":"ignite","version":"#).concat(version.to_text()).concat(r#","text":"#).concat(Json.Str(text).encode()).concat(r"}}}")

test fn change(uri: Text, version: Int, text: Text) -> Text =
  r#"{"jsonrpc":"2.0","method":"textDocument/didChange","params":{"textDocument":{"uri":"#.concat(Json.Str(uri).encode()).concat(r#","version":"#).concat(version.to_text()).concat(r#"},"contentChanges":[{"text":"#).concat(Json.Str(text).encode()).concat(r"}]}}")

test fn close(uri: Text) -> Text =
  r#"{"jsonrpc":"2.0","method":"textDocument/didClose","params":{"textDocument":{"uri":"#.concat(Json.Str(uri).encode()).concat(r"}}}")

test "didOpen, didChange and didClose keep the buffer table" {
  let a = "file:///w/a.ignite"
  let b = "file:///w/b.ignite"
  let (state, acts) = after([open(a, 1, "one"), open(b, 4, "two"), change(a, 2, "three"), close(b)])?
  assert state.buffers.len() == 1
  assert state.buffers.get(a) == Some(Buffer { text = "three", version = 2, saved = false })
  assert state.buffers.get(b) == None
  assert acts == [Publish(a), Publish(b), Publish(a), Clear(b)]
}

test "a change to a document that is not open changes nothing, and the last whole change wins" {
  let a = "file:///w/a.ignite"
  let (unopened, none) = after([change(a, 2, "x")])?
  assert unopened.buffers.len() == 0
  assert none == []
  let two = r#"{"jsonrpc":"2.0","method":"textDocument/didChange","params":{"textDocument":{"uri":"file:///w/a.ignite","version":3},"contentChanges":[{"text":"first"},{"text":"second"}]}}"#
  let (state, _) = after([open(a, 1, "zero"), two])?
  assert state.buffers.get(a) == Some(Buffer { text = "second", version = 3, saved = false })
}

test "a file URI is its percent-decoded path, another scheme has none" {
  assert path_of("file:///w/a.ignite") == Some("/w/a.ignite")
  assert path_of("file:///w/with%20space/%C3%A9.ignite") == Some("/w/with space/é.ignite")
  assert path_of("untitled:Untitled-1") == None
  assert path_of("file://host/a.ignite") == None
}

// RFC 8089 section 2: `localhost` as the authority names the local machine, as an empty one does.
test "a file URI with the localhost authority is its path" {
  assert path_of("file://localhost/w/a.ignite") == Some("/w/a.ignite")
  assert path_of("file://LocalHost/w/a%20b.ignite") == Some("/w/a b.ignite")
  assert path_of("file://localhost") == None
  assert path_of("file://localhostx/a.ignite") == None
}

test "a document that is no file is checked under a stand-in path and gets its diagnostics" {
  let (_, replies) = exchange([INITIALIZE, open("untitled:Untitled-1", 1, "broken"), SHUTDOWN, EXIT], script(0, 1))?
  assert replies == [
    CAPABILITIES_UTF16,
    r#"{"jsonrpc":"2.0","method":"textDocument/publishDiagnostics","params":{"uri":"untitled:Untitled-1","version":1,"diagnostics":[{"range":{"start":{"line":0,"character":0},"end":{"line":0,"character":1}},"severity":1,"code":"E040","source":"ignite","message":"type mismatch"}]}}"#,
    SHUT_DOWN
  ]
}

// JSON-RPC 2.0 section 6: a batch of notifications only gets no response; its notifications
// are acted on in order, as `std.protocol.jsonrpc`'s `serve` does.
test "a batch of notifications only gets no reply and its notifications are acted on" {
  let batch = "[".concat(INITIALIZED).concat(",").concat(open("file:///w/a.ignite", 1, "fine")).concat("]")
  let (code, replies) = exchange([INITIALIZE, batch, SHUTDOWN, EXIT], quiet())?
  assert code == 0
  assert replies == [
    CAPABILITIES_UTF16,
    r#"{"jsonrpc":"2.0","method":"textDocument/publishDiagnostics","params":{"uri":"file:///w/a.ignite","version":1,"diagnostics":[]}}"#,
    r#"{"jsonrpc":"2.0","id":2,"result":null}"#
  ]
}

test "a batch that holds a request is still one invalid-request error" {
  let batch = "[".concat(SHUTDOWN).concat("]")
  let (_, replies) = exchange([INITIALIZE, batch, EXIT], quiet())?
  assert replies == [CAPABILITIES_UTF16, r#"{"jsonrpc":"2.0","id":null,"error":{"code":-32600,"message":"Invalid Request"}}"#]
}

// A body of 200,000 bytes, over a 1 KiB limit and over several reads: its length is valid,
// so it is read past and answered with an error under a null id, and the session goes on.
test "a body over the limit is skipped with an error and the server keeps serving" {
  var input = frame(INITIALIZE)
  input.append(b"Content-Length: 200000\r\n\r\n")
  var body = b"xxxxxxxxxx"
  while body.len() < 200000 {
    body.append(b"xxxxxxxxxx")
  }
  input.append(body)
  input.append(frame(SHUTDOWN))
  input.append(frame(EXIT))
  let (code, replies) = exchange_bytes(input, JsonRpcLimits { body = 1 KiB }, quiet())?
  assert code == 0
  assert replies == [
    CAPABILITIES_UTF16,
    r#"{"jsonrpc":"2.0","id":null,"error":{"code":-32600,"message":"a message body of 200000 bytes is over the limit of 1024 bytes"}}"#,
    r#"{"jsonrpc":"2.0","id":2,"result":null}"#
  ]
}

test "a body over the limit that the input ends inside is the end, status 1" {
  var input = frame(INITIALIZE)
  input.append(b"Content-Length: 99999999999999\r\n\r\n{}")
  let (code, replies) = exchange_bytes(input, JsonRpcLimits {}, quiet())?
  assert code == 1
  assert replies == [CAPABILITIES_UTF16]
}

// "a€😀" then "é" on the next line: `a` is 1 byte, `€` 3 bytes and one UTF-16 unit, `😀` 4
// bytes and two units, `é` 2 bytes and one unit.
test "a byte offset is a position in utf-8 and in utf-16 for 1- to 4-byte characters" {
  let text = "a€😀\né|"
  assert position_at(text, 0, Utf8) == Position { line = 0, character = 0 }
  assert position_at(text, 1, Utf8) == Position { line = 0, character = 1 }
  assert position_at(text, 4, Utf8) == Position { line = 0, character = 4 }
  assert position_at(text, 8, Utf8) == Position { line = 0, character = 8 }
  assert position_at(text, 9, Utf8) == Position { line = 1, character = 0 }
  assert position_at(text, 11, Utf8) == Position { line = 1, character = 2 }
  assert position_at(text, 0, Utf16) == Position { line = 0, character = 0 }
  assert position_at(text, 1, Utf16) == Position { line = 0, character = 1 }
  assert position_at(text, 4, Utf16) == Position { line = 0, character = 2 }
  assert position_at(text, 8, Utf16) == Position { line = 0, character = 4 }
  assert position_at(text, 9, Utf16) == Position { line = 1, character = 0 }
  assert position_at(text, 11, Utf16) == Position { line = 1, character = 1 }
  assert position_at(text, 12, Utf16) == Position { line = 1, character = 2 }
  assert position_at(text, 99, Utf16) == Position { line = 1, character = 2 }
}

test "CR LF and a lone CR end a line" {
  assert position_at("ab\r\ncd", 5, Utf16) == Position { line = 1, character = 1 }
  assert position_at("ab\r\ncd", 3, Utf16) == Position { line = 0, character = 3 }
  assert position_at("ab\rcd", 4, Utf8) == Position { line = 1, character = 1 }
}

test "an opened buffer with an error publishes it at its range, a fixed one an empty list" {
  let uri = "file:///w/a.ignite"
  let text = "let x: Int = \"é\"\nbroken"
  let (code, replies) = exchange([
    INITIALIZE,
    INITIALIZED,
    open(uri, 1, text),
    ping(5),
    change(uri, 2, "fixed"),
    ping(6),
    close(uri),
    SHUTDOWN,
    EXIT
  ], script(13, 17))?
  assert code == 0
  assert replies == [
    CAPABILITIES_UTF16,
    r#"{"jsonrpc":"2.0","method":"textDocument/publishDiagnostics","params":{"uri":"file:///w/a.ignite","version":1,"diagnostics":[{"range":{"start":{"line":0,"character":13},"end":{"line":0,"character":16}},"severity":1,"code":"E040","source":"ignite","message":"type mismatch"}]}}"#,
    pong(5),
    r#"{"jsonrpc":"2.0","method":"textDocument/publishDiagnostics","params":{"uri":"file:///w/a.ignite","version":2,"diagnostics":[]}}"#,
    pong(6),
    r#"{"jsonrpc":"2.0","method":"textDocument/publishDiagnostics","params":{"uri":"file:///w/a.ignite","diagnostics":[]}}"#,
    r#"{"jsonrpc":"2.0","id":2,"result":null}"#
  ]
}

// A request the server does not implement, and its answer: it makes the server run the checks
// that wait, so a test can see each version's diagnostics.
test fn ping(id: Int) -> Text = r#"{"jsonrpc":"2.0","id":"#.concat(id.to_text()).concat(r#","method":"x/ping"}"#)

test fn pong(id: Int) -> Text = r#"{"jsonrpc":"2.0","id":"#.concat(id.to_text()).concat(r#","error":{"code":-32601,"message":"method not found: x/ping"}}"#)

test const SHUT_DOWN: Text = r#"{"jsonrpc":"2.0","id":2,"result":null}"#

// The publishDiagnostics of `/w/a.ignite` at `version` with `diagnostics`, JSON items joined.
test fn published(version: Int, diagnostics: Text) -> Text =
  r#"{"jsonrpc":"2.0","method":"textDocument/publishDiagnostics","params":{"uri":"file:///w/a.ignite","version":"#.concat(version.to_text()).concat(r#","diagnostics":["#).concat(diagnostics).concat(r"]}}")

test "changes that arrive together are checked once, at the newest version" {
  let uri = "file:///w/a.ignite"
  let (code, replies) = exchange([
    INITIALIZE,
    open(uri, 1, "one"),
    change(uri, 2, "two"),
    change(uri, 3, "three"),
    SHUTDOWN,
    EXIT
  ], quiet())?
  assert code == 0
  assert replies == [CAPABILITIES_UTF16, published(3, ""), SHUT_DOWN]
}

// A checker that reports, for a buffer holding `broken`, one E040 over bytes 0 to 1, and for a
// buffer holding `syntax`, one E002 at the empty range at byte `at`; else nothing.
test fn syntax_script(at: Int) -> Checker = Checker {
  tools = Launcher.new()
  program = "/bin/sh"
  prefix = [
    "-c",
    r#"input=$(cat); case "$input" in *syntax*) printf '{"diagnostics":[{"code":"E002","message":"unexpected end of file","path":"%s","start":{"offset":%s},"end":{"offset":%s}}]}\n' "$4" "$0" "$0";; *broken*) printf '{"diagnostics":[{"code":"E040","message":"type mismatch","path":"%s","start":{"offset":0},"end":{"offset":1}}]}\n' "$4";; *) printf '{"diagnostics":[]}\n';; esac"#,
    at.to_text()
  ]
}

test fn mismatch(prefix: Text, severity: Int) -> Text =
  r#"{"range":{"start":{"line":0,"character":0},"end":{"line":0,"character":1}},"severity":"#.concat(severity.to_text()).concat(r#","code":"E040","source":"ignite","message":""#).concat(prefix).concat(r#"type mismatch"}"#)

test fn end_of_file(start: Int, end: Int) -> Text =
  r#"{"range":{"start":{"line":1,"character":"#.concat(start.to_text()).concat(r#"},"end":{"line":1,"character":"#).concat(end.to_text()).concat(r#"}},"severity":1,"code":"E002","source":"ignite","message":"unexpected end of file"}"#)

test "a syntax error keeps the type errors before it, marked stale, and a fix drops them" {
  let uri = "file:///w/a.ignite"
  let (_, replies) = exchange([
    INITIALIZE,
    open(uri, 1, "broken"),
    ping(5),
    change(uri, 2, "broken\nsyntax + \n"),
    ping(6),
    change(uri, 3, "fine"),
    SHUTDOWN,
    EXIT
  ], syntax_script(17))?
  assert replies == [
    CAPABILITIES_UTF16,
    published(1, mismatch("", 1)),
    pong(5),
    published(2, end_of_file(7, 8).concat(",").concat(mismatch("(before the syntax error) ", 2))),
    pong(6),
    published(3, ""),
    SHUT_DOWN
  ]
}

test "an empty range is widened to the token there, else back to the last character before it" {
  let text = "fn f() -> Int = nope + \n\n"
  assert widened(text.to_bytes(), 16, 16) == (16, 20)
  assert widened(text.to_bytes(), 21, 21) == (21, 22)
  assert widened(text.to_bytes(), 25, 25) == (21, 22)
  assert widened(text.to_bytes(), 23, 23) == (21, 22)
  assert widened("é".to_bytes(), 2, 2) == (0, 2)
  assert widened(b"", 0, 0) == (0, 0)
  assert widened(text.to_bytes(), 3, 5) == (3, 5)
}

// A compiler for the queries: `emit` prints `SAMPLE_DOCUMENT` and appends a line to
// `<log>/emits` (its path, and `stdin` when it was given the buffer); `check` prints no
// diagnostic.
test fn emitter(log: Text) -> Checker = Checker {
  tools = Launcher.new()
  program = "/bin/sh"
  prefix = [
    "-c",
    r#"if [ "$2" = emit ]; then echo "$4" >> "$1/emits"; printf '%s\n' "$0"; else printf '{"diagnostics":[]}\n'; fi"#,
    SAMPLE_DOCUMENT,
    log
  ]
}

test fn asked(id: Int, method: Text, uri: Text, line: Int, character: Int) -> Text =
  r#"{"jsonrpc":"2.0","id":"#.concat(id.to_text()).concat(r#","method":""#).concat(method).concat(r#"","params":{"textDocument":{"uri":"#).concat(Json.Str(uri).encode()).concat(r#"},"position":{"line":"#).concat(line.to_text()).concat(r#","character":"#).concat(character.to_text()).concat(r"}}}")

test fn saved(uri: Text) -> Text =
  r#"{"jsonrpc":"2.0","method":"textDocument/didSave","params":{"textDocument":{"uri":"#.concat(Json.Str(uri).encode()).concat(r"}}}")

test "hover, definition and the outline answer from one typed document per buffer version" {
  let files = Directory.temporary()?
  let log = files.absolute_path()?
  let uri = "file:///w/sample.ignite"
  let (code, replies) = exchange([
    INITIALIZE,
    open(uri, 1, SAMPLE_TEXT),
    asked(3, "textDocument/hover", uri, 16, 17),
    asked(4, "textDocument/definition", uri, 16, 17),
    asked(5, "textDocument/hover", uri, 30, 47),
    asked(6, "textDocument/definition", uri, 33, 13),
    asked(7, "textDocument/hover", uri, 11, 0),
    r#"{"jsonrpc":"2.0","id":8,"method":"textDocument/documentSymbol","params":{"textDocument":{"uri":"file:///w/sample.ignite"}}}"#,
    change(uri, 2, SAMPLE_TEXT),
    asked(9, "textDocument/hover", uri, 16, 17),
    saved(uri),
    asked(10, "textDocument/hover", uri, 16, 17),
    asked(11, "textDocument/hover", "file:///w/other.ignite", 0, 0),
    SHUTDOWN,
    EXIT
  ], emitter(log))?
  assert code == 0
  let hover_wider = r#"{"jsonrpc":"2.0","id":3,"result":{"contents":{"kind":"markdown","value":"```ignite\nlet wider: Int\n```"},"range":{"start":{"line":16,"character":16},"end":{"line":16,"character":21}}}}"#
  assert replies[1] == hover_wider
  assert replies[2] == r#"{"jsonrpc":"2.0","id":4,"result":{"uri":"file:///w/sample.ignite","range":{"start":{"line":15,"character":6},"end":{"line":15,"character":11}}}}"#
  assert replies[3] == r#"{"jsonrpc":"2.0","id":5,"result":{"contents":{"kind":"markdown","value":"```ignite\nfn std.text.split(…) -> List<Text>\n```"},"range":{"start":{"line":30,"character":45},"end":{"line":30,"character":50}}}}"#
  assert replies[4] == r#"{"jsonrpc":"2.0","id":6,"result":{"uri":"file:///w/sample.ignite","range":{"start":{"line":14,"character":3},"end":{"line":14,"character":7}}}}"#
  assert replies[5] == r#"{"jsonrpc":"2.0","id":7,"result":null}"#
  assert replies[6].starts_with(r#"{"jsonrpc":"2.0","id":8,"result":[{"name":"Box","detail":"type","kind":23,"range":{"start":{"line":2,"character":0},"end":{"line":5,"character":1}},"selectionRange":{"start":{"line":2,"character":5},"end":{"line":2,"character":8}},"children":[{"name":"width","detail":"Int","kind":8,"#)
  assert replies[7] == hover_wider.replace(r#""id":3"#, r#""id":9"#)
  assert replies[8] == hover_wider.replace(r#""id":3"#, r#""id":10"#)
  assert replies[9] == r#"{"jsonrpc":"2.0","id":11,"result":null}"#
  assert files.read_text_file("emits")? == "/w/sample.ignite\n/dev/stdin\n/w/sample.ignite\n"
}

test "a query with params that do not decode is InvalidParams" {
  let (_, replies) = exchange([INITIALIZE, r#"{"jsonrpc":"2.0","id":3,"method":"textDocument/hover","params":{}}"#, EXIT], quiet())?
  assert replies.len() == 2
  assert replies[1].starts_with(r#"{"jsonrpc":"2.0","id":3,"error":{"code":-32602,"message":"textDocument/hover params: "#)
}

test "a compiler that cannot run is one diagnostic saying why" {
  let missing = Checker { tools = Launcher.new(), program = "/nonexistent/ignite" }
  let diagnostics = check(missing, "/w/a.ignite", "x", Utf16)
  assert diagnostics.len() == 1
  assert diagnostics[0].message == "ignite check did not run: program not found: /nonexistent/ignite"
  assert diagnostics[0].source == Some("ignite-lsp")
}

// A checker whose output is one diagnostic of the checked file at bytes 0 to 1 with a
// message of `size` bytes of `x`.
test fn verbose(size: Int) -> Checker = Checker {
  tools = Launcher.new()
  program = "/bin/sh"
  prefix = [
    "-c",
    r#"printf '{"diagnostics":[{"code":"E040","message":"'; head -c "$0" /dev/zero | tr '\000' x; printf '","path":"%s","start":{"offset":0},"end":{"offset":1}}]}\n' "$4""#,
    size.to_text()
  ]
}

test "an output over a mebibyte still gives its diagnostics" {
  let diagnostics = check(verbose(2097152), "/w/a.ignite", "x", Utf16)
  assert diagnostics.len() == 1
  assert diagnostics[0].source == Some("ignite")
  assert diagnostics[0].message.len() == 2097152
}

test "an output past the limit is one diagnostic that says it was cut off" {
  let diagnostics = check(verbose(17825792), "/w/a.ignite", "x", Utf16)
  assert diagnostics.len() == 1
  assert diagnostics[0].source == Some("ignite-lsp")
  assert diagnostics[0].message.starts_with("ignite check printed more than 16 MiB; ")
}

// One diagnostic of `/w/a.ignite` at bytes `start` to `end`, as `ignite check --json` prints it.
test fn located(start: Int, end: Int) -> Text =
  r#"{"code":"E040","message":"m","path":"/w/a.ignite","start":{"offset":"#.concat(start.to_text()).concat(r#"},"end":{"offset":"#).concat(end.to_text()).concat(r"}}")

// 40,000 lines (1.1 MB) with a diagnostic on every 40th: the positions come from one pass
// over the document, not one per diagnostic (16 to 22 s before, on both targets).
test "a thousand diagnostics on a megabyte document are placed in one pass over it" {
  var lines: List<Text> = []
  var items: List<Text> = []
  var offset = 0
  var index = 0
  while index < 40000 {
    let line = "fn f{index}() -> Int = {index}\n"
    if index % 40 == 39 {
      items.push(located(offset + 3, offset + 4))
    }
    lines.push(line)
    offset = offset + line.len()
    index = index + 1
  }
  let output = r#"{"diagnostics":["#.concat(items.join(",")).concat(r"]}")
  let started = Clock.monotonic()
  let found = diagnostics_in(output, "/w/a.ignite", lines.join(""), Utf16)
  assert Clock.monotonic() - started < 5 seconds
  assert found.len() == 1000
  assert found[999].range == Range { start = Position { line = 39999, character = 3 }, end = Position { line = 39999, character = 4 } }
}

test "a diagnostic of another file is placed at the start with its path" {
  let output = r#"{"diagnostics":[{"code":"E031","end":{"column":3,"line":2,"offset":9},"message":"unknown module","path":"/w/b.ignite","start":{"column":1,"line":2,"offset":7}}]}"#
  let found = diagnostics_in(output, "/w/a.ignite", "abc", Utf16)
  assert found.len() == 1
  assert found[0].range == Range { start = Position { line = 0, character = 0 }, end = Position { line = 0, character = 0 } }
  assert found[0].message == "/w/b.ignite: unknown module"
}

// ---- tests of the typed index (src/typed.ignite) ---------------------------------------
// `SAMPLE_DOCUMENT` is what `ignite emit --typed-json` (v0.13.0) printed for `SAMPLE_TEXT`.
test const SAMPLE_TEXT: Text = r#"import std.text.split

type Box {
  width: Int
  label: Text
}

enum Shape {
  Square(Int)
  Empty
}

const LIMIT: Int = 10

fn grow(box: Box, by: Int) -> Box {
  let wider = box.width + by
  Box { width = wider, label = box.label }
}

fn size(shape: Shape) -> Int = match shape {
  Square(side) => side * LIMIT
  Empty => 0
}

fn twice(box: Box) -> Int {
  let x = box.width
  let x = x + x
  x
}

fn words(box: Box) -> List<Text> = box.label.split(" ")

test "grow adds" {
  let box = grow(Box { width = 1, label = "a b" }, 2)
  assert box.twice() == 6
  assert size(Square(box.width)) == 30
}
"#

test const SAMPLE_DOCUMENT: Text = r#"{"decls":[{"fields":[{"default":null,"name":"width","satisfies":[],"span":{"column":3,"end":46,"endColumn":13,"endLine":4,"file":0,"line":4,"start":36},"type":{"kind":"Int","text":"Int"}},{"default":null,"name":"label","satisfies":[],"span":{"column":3,"end":60,"endColumn":14,"endLine":5,"file":0,"line":5,"start":49},"type":{"kind":"Text","text":"Text"}}],"kind":"record","name":"Box","satisfies":[],"span":{"column":1,"end":62,"endColumn":2,"endLine":6,"file":0,"line":3,"start":23},"testOnly":false,"typeParams":[]},{"kind":"enum","name":"Shape","span":{"column":1,"end":100,"endColumn":2,"endLine":11,"file":0,"line":8,"start":64},"testOnly":false,"typeParams":[],"variants":[{"name":"Square","payload":[{"kind":"Int","text":"Int"}],"span":{"column":3,"end":90,"endColumn":14,"endLine":9,"file":0,"line":9,"start":79}},{"name":"Empty","payload":[],"span":{"column":3,"end":98,"endColumn":8,"endLine":10,"file":0,"line":10,"start":93}}]},{"kind":"const","name":"LIMIT","span":{"column":1,"end":123,"endColumn":22,"endLine":13,"file":0,"line":13,"start":102},"testOnly":false,"type":{"kind":"Int","text":"Int"},"value":0},{"body":{"span":{"column":35,"end":234,"endColumn":2,"endLine":18,"file":0,"line":15,"start":159},"stmts":[0,1]},"bounds":[],"effectful":false,"kind":"fn","name":"grow","owner":null,"params":[{"name":"box","span":{"column":9,"end":141,"endColumn":17,"endLine":15,"file":0,"line":15,"start":133},"type":{"args":[],"kind":"Record","module":"main","name":"Box","text":"Box"}},{"name":"by","span":{"column":19,"end":150,"endColumn":26,"endLine":15,"file":0,"line":15,"start":143},"type":{"kind":"Int","text":"Int"}}],"qualifiedName":"grow","requires":null,"ret":{"args":[],"kind":"Record","module":"main","name":"Box","text":"Box"},"satisfies":[],"span":{"column":1,"end":234,"endColumn":2,"endLine":18,"file":0,"line":15,"start":125},"testOnly":false,"typeParams":[]},{"body":{"span":{"column":32,"end":326,"endColumn":2,"endLine":23,"file"