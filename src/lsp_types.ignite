// doesn't know"), so a client capability's `valueSet` that names a newer value
// still decodes.
fn decode_list_of_symbol_kind(value: Json, at: Text) -> Result<List<SymbolKind>, Text> = match value {
  Json.Array(items) => {
    var out: List<SymbolKind> = []
    for item in items {
      match SymbolKind.from_json(item) {
        Ok(known) => out.push(known)
        Err(_) => {}
      }
    }
    Ok(out)
  }
  _ => Err(at + ": expected an array")
}

fn encode_list_of_symbol_kind(items: List<SymbolKind>) -> Json = Json.Array(items.map(|item| SymbolKind.to_json(item)))

