// Int or null.
fn decode_option_of_int(value: Json, at: Text) -> Result<Option<Int>, Text> = match value {
  Json.Null => Ok(Option.None)
  other => Ok(Some(decode_int(other, at)?))
}

fn encode_option_of_int(value: Option<Int>) -> Json = match value {
  Some(item) => Json.Number(item)
  Option.None => Json.Null
}

// DocumentSelector or null.
fn decode_option_of_list_of_document_filter(value: Json, at: Text) -> Result<Option<DocumentSelector>, Text> = match value {
  Json.Null => Ok(Option.None)
  other => Ok(Some(decode_list_of_document_filter(other, at)?))
}

fn encode_option_of_list_of_document_filter(value: Option<DocumentSelector>) -> Json = match value {
  Some(item) => encode_list_of_document_filter(item)
  Option.None => Json.Null
}

// List<WorkspaceFolder> or null.
fn decode_option_of_list_of_workspace_folder(value: Json, at: Text) -> Result<Option<List<WorkspaceFolder>>, Text> = match value {
  Json.Null => Ok(Option.None)
  other => Ok(Some(decode_list_of_workspace_folder(other, at)?))
}

fn encode_option_of_list_of_workspace_folder(value: Option<List<WorkspaceFolder>>) -> Json = match value {
  Some(item) => encode_list_of_workspace_folder(item)
  Option.None => Json.Null
}

// Text or null.
fn decode_option_of_text(value: Json, at: Text) -> Result<Option<Text>, Text> = match value {
  Json.Null => Ok(Option.None)
  other => Ok(Some(decode_text(other, at)?))
}

fn encode_option_of_text(value: Option<Text>) -> Json = match value {
  Some(item) => Json.Str(item)
  Option.None => Json.Null
}
