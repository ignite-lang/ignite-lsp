// An LSP `integer`: -2^31 to 2^31 - 1.
fn decode_int(value: Json, at: Text) -> Result<Int, Text> = match value {
  Json.Number(n) => if n >= -2147483648 && n <= 2147483647 { Ok(n) } else { Err(at + ": integer out of range") }
  _ => Err(at + ": expected an integer")
}

// Any JSON value (`LSPAny`, `LSPObject`, `LSPArray`); `at` is unused, every value is one.
fn decode_json(value: Json, at: Text) -> Result<Json, Text> = Ok(value)

// A JSON string.
fn decode_text(value: Json, at: Text) -> Result<Text, Text> = match value {
  Json.Str(text) => Ok(text)
  _ => Err(at + ": expected a string")
}

// An LSP `uinteger`: 0 to 2^31 - 1.
fn decode_uinteger(value: Json, at: Text) -> Result<Int, Text> = match value {
  Json.Number(n) => if n >= 0 && n <= 2147483647 { Ok(n) } else { Err(at + ": uinteger out of range") }
  _ => Err(at + ": expected an unsigned integer")
}

// Whether a value is a JSON object with a member of each of `names`, null or not.
fn has_members(value: Json, names: List<Text>) -> Bool {
  if !is_object(value) {
    return false
  }
  for name in names {
    if value.get(name) == Option.None {
      return false
    }
  }
  true
}

// Whether a value is a JSON boolean.
fn is_bool(value: Json) -> Bool = match value {
  Json.Bool(_) => true
  _ => false
}

// Whether a value is a JSON number.
