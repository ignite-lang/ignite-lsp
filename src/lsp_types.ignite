}

fn encode_list_of_symbol_tag(items: List<SymbolTag>) -> Json = Json.Array(items.map(|item| SymbolTag.to_json(item)))

// A JSON array of Text.
fn decode_list_of_text(value: Json, at: Text) -> Result<List<Text>, Text> = match value {
  Json.Array(items) => {
    var out: List<Text> = []
    var index = 0
    for item in items {
      out.push(decode_text(item, "{at}[{index}]")?)
      index = index + 1
    }
    Ok(out)
  }
  _ => Err(at + ": expected an array")
}

fn encode_list_of_text(items: List<Text>) -> Json = Json.Array(items.map(|item| Json.Str(item)))

