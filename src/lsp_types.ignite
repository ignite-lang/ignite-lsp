    }
    Ok(out)
  }
  _ => Err(at + ": expected an array")
}

fn encode_list_of_text_document_content_change_event(items: List<TextDocumentContentChangeEvent>) -> Json = Json.Array(items.map(|item| TextDocumentContentChangeEvent.to_json(item)))

