package lsp

import std.json.{Json, parse, get}
import std.protocol.jsonrpc.{Message, Id, decode, encode_message}
import lsp.lsp_types.{
  METHOD_INITIALIZE, METHOD_INITIALIZED, METHOD_SHUTDOWN, METHOD_EXIT,
  METHOD_TEXT_DOCUMENT_DID_OPEN, METHOD_TEXT_DOCUMENT_DID_CHANGE, METHOD_TEXT_DOCUMENT_DID_CLOSE,
  METHOD_TEXT_DOCUMENT_PUBLISH_DIAGNOSTICS, METHOD_CANCEL_REQUEST,
  InitializeParams, InitializeResult, InitializedParams, DidOpenTextDocumentParams,
  DidChangeTextDocumentParams, DidCloseTextDocumentParams, PublishDiagnosticsParams, CancelParams,
  CancelParamsId, TextDocumentContentChangeEvent, ServerCapabilitiesSemanticTokensProvider,
  ServerCapabilitiesTextDocumentSync, TextDocumentSyncKind, DiagnosticCode, DiagnosticSeverity,
  Position, PositionEncodingKind, TraceValues, DiagnosticTag, DocumentFilter,
  METHOD_TEXT_DOCUMENT_DID_SAVE, METHOD_TEXT_DOCUMENT_HOVER, METHOD_TEXT_DOCUMENT_DEFINITION,
  METHOD_TEXT_DOCUMENT_DOCUMENT_SYMBOL, DidSaveTextDocumentParams, HoverParams, Hover, HoverContents,
  DefinitionParams, TextDocumentDefinitionResult, Definition, DocumentSymbolParams,
  TextDocumentDocumentSymbolResult, DocumentSymbol, SymbolKind, MarkupKind
}

// Round trips of the generated LSP types (`lsp_types.ignite`, story:lsp-types): for each root
// method, a JSON-RPC message in the base protocol's form (LSP 3.17, "Base Protocol",
// `{"jsonrpc": "2.0", "id": 1, "method": ...}`) whose params or result decode into the
// generated type and encode back to an equal `Json`. The 3.17 specification has no complete
// JSON message for these methods, so each example is assembled from what it does quote: the
// document `{"uri": "file:///folder/file.ts"}` and the progress token
// `"1d546990-40a3-4b77-b134-46622995f6ae"` ("Work Done Progress"), the server capability
// `{"referencesProvider": {"workDoneProgress": true}}` (same section), the range
// `{start: {line: 5, character: 23}, end: {line: 6, character: 0}}` ("Range"), the cell text
// `function add(a, b) {...}` ("Notebook Document"), and the values the specification
// defines (`"utf-16"`, `"off"`, `TextDocumentSyncKind.Incremental` = 2,
// `DiagnosticSeverity.Error` = 1). JSON objects are unordered (RFC 8259 section 4), so two
// values are compared after `canonical` sorts every object's members by name.

// `value` with the members of every object sorted by name.
test fn canonical(value: Json) -> Json = match value {
  Array(items) => Array(items.map(canonical))
  Object(members) => {
    var sorted: Map<Text, Json> = Map.empty()
    for member in members {
      sorted.put(member.0, canonical(member.1))
    }
    var out: List<(Text, Json)> = []
    for (name, item) in sorted {
      out.push((name, item))
    }
    Object(out)
  }
  other => other
}

// The method and params of a request or notification.
test fn call_of(text: Text) -> Option<(Text, Option<Json>)> = match decode(text) {
  Ok(Call(request)) => Some((request.method, request.params))
  Ok(Notify(notification)) => Some((notification.method, notification.params))
  _ => Option.None
}

// The result of a successful response.
test fn result_of(text: Text) -> Option<Json> = match decode(text) {
  Ok(Reply(response)) => match response.outcome {
    Ok(result) => Some(result)
    Err(_) => Option.None
  }
  _ => Option.None
}

test const INITIALIZE: Text = r#"{
  "jsonrpc": "2.0",
  "id": 1,
  "method": "initialize",
  "params": {
    "processId": 1234,
    "clientInfo": { "name": "client", "version": "1.0" },
    "locale": "en",
    "rootPath": null,
    "rootUri": "file:///folder",
    "capabilities": {
      "textDocument": {
        "synchronization": { "dynamicRegistration": true, "didSave": true },
        "publishDiagnostics": { "relatedInformation": true, "tagSupport": { "valueSet": [1, 2] } }
      },
      "general": { "positionEncodings": ["utf-16"] }
    },
    "initializationOptions": { "anything": [1, 2.5, "x", null] },
    "trace": "off",
    "workspaceFolders": null,
    "workDoneToken": "1d546990-40a3-4b77-b134-46622995f6ae"
  }
}"#

test "initialize params decode and re-encode equal" {
  let (method, params) = call_of(INITIALIZE)?
  assert method == METHOD_INITIALIZE
  let json = params?
  let decoded = InitializeParams.from_json(json)?
  assert decoded.process_id == Some(1234)
  assert decoded.root_path == Some(Option.None)
  assert decoded.root_uri == Some("file:///folder")
  assert decoded.workspace_folders == Some(Option.None)
  assert decoded.trace == Some(TraceValues.Off)
  assert decoded.capabilities.general?.position_encodings == Some([PositionEncodingKind.UTF16])
  assert canonical(InitializeParams.to_json(decoded)) == canonical(json)
}

test const INITIALIZE_RESULT: Text = r#"{
  "jsonrpc": "2.0",
  "id": 1,
  "result": {
    "capabilities": {
      "positionEncoding": "utf-16",
      "textDocumentSync": { "openClose": true, "change": 2 },
      "referencesProvider": { "workDoneProgress": true },
      "hoverProvider": true,
      "semanticTokensProvider": {
        "legend": { "tokenTypes": ["property", "type", "class"], "tokenModifiers": [] },
        "full": { "delta": true },
        "documentSelector": null
      }
    },
    "serverInfo": { "name": "ignite", "version": "0.4.0" }
  }
}"#

test "initialize result decodes and re-encodes equal" {
  let json = result_of(INITIALIZE_RESULT)?
  let decoded = InitializeResult.from_json(json)?
  match decoded.capabilities.text_document_sync? {
    ServerCapabilitiesTextDocumentSync.TextDocumentSyncOptions(options) => { assert options.change == Some(TextDocumentSyncKind.Incremental) }
    other => { assert false, "expected the options arm, got {other.debug()}" }
  }
  match decoded.capabilities.semantic_tokens_provider? {
    ServerCapabilitiesSemanticTokensProvider.SemanticTokensRegistrationOptions(options) => { assert options.document_selector == Option.None }
    other => { assert false, "a documentSelector selects the registration arm, got {other.debug()}" }
  }
  assert canonical(InitializeResult.to_json(decoded)) == canonical(json)
}

test "a bare sync kind takes the enumeration arm" {
  let kind = ServerCapabilitiesTextDocumentSync.from_json(parse("1")?)?
  assert kind == ServerCapabilitiesTextDocumentSync.TextDocumentSyncKind(TextDocumentSyncKind.Full)
  assert ServerCapabilitiesTextDocumentSync.to_json(kind) == Json.Number(1)
}

test "initialized params decode and re-encode equal" {
  let (method, params) = call_of(r#"{"jsonrpc": "2.0", "method": "initialized", "params": {}}"#)?
  assert method == METHOD_INITIALIZED
  let json = params?
  assert canonical(InitializedParams.to_json(InitializedParams.from_json(json)?)) == canonical(json)
}

test "shutdown has no params and a null result" {
  let request = r#"{"jsonrpc":"2.0","id":1,"method":"shutdown"}"#
  let (method, params) = call_of(request)?
  assert method == METHOD_SHUTDOWN
  assert params == Option.None
  assert encode_message(decode(request)?) == request
  let response = r#"{"jsonrpc":"2.0","id":1,"result":null}"#
  assert result_of(response)? == Json.Null
  assert encode_message(decode(response)?) == response
}

test "exit has no params" {
  let notification = r#"{"jsonrpc":"2.0","method":"exit"}"#
  let (method, params) = call_of(notification)?
  assert method == METHOD_EXIT
  assert params == Option.None
  assert encode_message(decode(notification)?) == notification
}

test const DID_OPEN: Text = r#"{
  "jsonrpc": "2.0",
  "method": "textDocument/didOpen",
  "params": {
    "textDocument": {
      "uri": "file:///folder/file.ts",
      "languageId": "typescript",
      "version": 1,
      "text": "function add(a, b) {\n\treturn a + b;\n}\n"
    }
  }
}"#

test "didOpen params decode and re-encode equal" {
  let (method, params) = call_of(DID_OPEN)?
  assert method == METHOD_TEXT_DOCUMENT_DID_OPEN
  let json = params?
  let decoded = DidOpenTextDocumentParams.from_json(json)?
  assert decoded.text_document.text == "function add(a, b) {{\n\treturn a + b;\n}}\n"
  assert canonical(DidOpenTextDocumentParams.to_json(decoded)) == canonical(json)
}

test const DID_CHANGE: Text = r#"{
  "jsonrpc": "2.0",
  "method": "textDocument/didChange",
  "params": {
    "textDocument": { "uri": "file:///folder/file.ts", "version": 2 },
    "contentChanges": [
      { "range": { "start": { "line": 5, "character": 23 }, "end": { "line": 6, "character": 0 } }, "text": "b" },
      { "text": "function add(a, b) {}" }
    ]
  }
}"#

test "didChange params decode and re-encode equal" {
  let (method, params) = call_of(DID_CHANGE)?
  assert method == METHOD_TEXT_DOCUMENT_DID_CHANGE
  let json = params?
  let decoded = DidChangeTextDocumentParams.from_json(json)?
  match decoded.content_changes[0] {
    TextDocumentContentChangeEvent.TextDocumentContentChangeEventLiteral1(change) => {
      assert change.range.start == Position { line = 5, character = 23 }
      assert change.text == "b"
    }
    other => { assert false, "a range selects the incremental arm, got {other.debug()}" }
  }
  match decoded.content_changes[1] {
    TextDocumentContentChangeEvent.TextDocumentContentChangeEventLiteral2(change) => { assert change.text == "function add(a, b) {{}}" }
    other => { assert false, "text alone selects the full arm, got {other.debug()}" }
  }
  assert canonical(DidChangeTextDocumentParams.to_json(decoded)) == canonical(json)
}

test "didClose params decode and re-encode equal" {
  let message = r#"{"jsonrpc": "2.0", "method": "textDocument/didClose", "params": {"textDocument": {"uri": "file:///folder/file.ts"}}}"#
  let (method, params) = call_of(message)?
  assert method == METHOD_TEXT_DOCUMENT_DID_CLOSE
  let json = params?
  let decoded = DidCloseTextDocumentParams.from_json(json)?
  assert decoded.text_document.uri == "file:///folder/file.ts"
  assert canonical(DidCloseTextDocumentParams.to_json(decoded)) == canonical(json)
}

test const PUBLISH_DIAGNOSTICS: Text = r#"{
  "jsonrpc": "2.0",
  "method": "textDocument/publishDiagnostics",
  "params": {
    "uri": "file:///folder/file.ts",
    "version": 2,
    "diagnostics": [
      {
        "range": { "start": { "line": 5, "character": 23 }, "end": { "line": 6, "character": 0 } },
        "severity": 1,
        "code": "E001",
        "source": "ignite",
        "message": "unterminated string",
        "tags": [1]
      },
      {
        "range": { "start": { "line": 9, "character": 5 }, "end": { "line": 9, "character": 8 } },
        "code": 42,
        "message": "unused"
      }
    ]
  }
}"#

test "publishDiagnostics params decode and re-encode equal" {
  let (method, params) = call_of(PUBLISH_DIAGNOSTICS)?
  assert method == METHOD_TEXT_DOCUMENT_PUBLISH_DIAGNOSTICS
  let json = params?
  let decoded = PublishDiagnosticsParams.from_json(json)?
  assert decoded.diagnostics[0].severity == Some(DiagnosticSeverity.Error)
  assert decoded.diagnostics[0].code == Some(DiagnosticCode.String("E001"))
  assert decoded.diagnostics[1].code == Some(DiagnosticCode.Integer(42))
  assert canonical(PublishDiagnosticsParams.to_json(decoded)) == canonical(json)
}

test "cancelRequest params decode and re-encode equal, number or string id" {
  for message in [
    r#"{"jsonrpc": "2.0", "method": "$/cancelRequest", "params": {"id": 1}}"#,
    r#"{"jsonrpc": "2.0", "method": "$/cancelRequest", "params": {"id": "1d546990-40a3-4b77-b134-46622995f6ae"}}"#
  ] {
    let (method, params) = call_of(message)?
    assert method == METHOD_CANCEL_REQUEST
    let json = params?
    assert canonical(CancelParams.to_json(CancelParams.from_json(json)?)) == canonical(json)
  }
  let numbered = CancelParams.from_json(parse(r#"{"id": 1}"#)?)?
  assert numbered.id == CancelParamsId.Integer(1)
}

test "didSave params decode and re-encode equal, with and without the text" {
  for message in [
    r#"{"jsonrpc": "2.0", "method": "textDocument/didSave", "params": {"textDocument": {"uri": "file:///folder/file.ts"}}}"#,
    r#"{"jsonrpc": "2.0", "method": "textDocument/didSave", "params": {"textDocument": {"uri": "file:///folder/file.ts"}, "text": "b"}}"#
  ] {
    let (method, params) = call_of(message)?
    assert method == METHOD_TEXT_DOCUMENT_DID_SAVE
    let json = params?
    assert canonical(DidSaveTextDocumentParams.to_json(DidSaveTextDocumentParams.from_json(json)?)) == canonical(json)
  }
}

test const POSITIONED: Text = r#"{"textDocument": {"uri": "file:///folder/file.ts"}, "position": {"line": 5, "character": 23}, "workDoneToken": "1d546990-40a3-4b77-b134-46622995f6ae"}"#

test "hover params and result decode and re-encode equal" {
  let (method, params) = call_of(r#"{"jsonrpc": "2.0", "id": 1, "method": "textDocument/hover", "params": "#.concat(POSITIONED).concat(r"}"))?
  assert method == METHOD_TEXT_DOCUMENT_HOVER
  let json = params?
  let decoded = HoverParams.from_json(json)?
  assert decoded.position == Position { line = 5, character = 23 }
  assert canonical(HoverParams.to_json(decoded)) == canonical(json)
  let result = result_of(r#"{"jsonrpc": "2.0", "id": 1, "result": {"contents": {"kind": "markdown", "value": "`b`"}, "range": {"start": {"line": 5, "character": 23}, "end": {"line": 6, "character": 0}}}}"#)?
  let hover = Hover.from_json(result)?
  match hover.contents {
    HoverContents.MarkupContent(content) => { assert content.kind == MarkupKind.Markdown }
    other => { assert false, "kind and value select markup content, got {other.debug()}" }
  }
  assert canonical(Hover.to_json(hover)) == canonical(result)
}

test "definition params and result decode and re-encode equal" {
  let (method, params) = call_of(r#"{"jsonrpc": "2.0", "id": 1, "method": "textDocument/definition", "params": "#.concat(POSITIONED).concat(r"}"))?
  assert method == METHOD_TEXT_DOCUMENT_DEFINITION
  let json = params?
  assert canonical(DefinitionParams.to_json(DefinitionParams.from_json(json)?)) == canonical(json)
  let result = result_of(r#"{"jsonrpc": "2.0", "id": 1, "result": {"uri": "file:///folder/file.ts", "range": {"start": {"line": 5, "character": 23}, "end": {"line": 6, "character": 0}}}}"#)?
  let decoded = TextDocumentDefinitionResult.from_json(result)?
  match decoded {
    TextDocumentDefinitionResult.Definition(Definition.Location(location)) => { assert location.uri == "file:///folder/file.ts" }
    other => { assert false, "one location selects the location arm, got {other.debug()}" }
  }
  assert canonical(TextDocumentDefinitionResult.to_json(decoded)) == canonical(result)
}

// The result `SymbolInformation[] | DocumentSymbol[]` is two arrays: the generator selects an
// arm by the value.s shape alone, so it decodes every array as the first arm and a list of
// document symbols does not decode. The server only encodes it; its symbols are decoded
// one by one here.
test "documentSymbol params decode and re-encode equal, and a result of document symbols encodes as sent" {
  let (method, params) = call_of(r#"{"jsonrpc": "2.0", "id": 1, "method": "textDocument/documentSymbol", "params": {"textDocument": {"uri": "file:///folder/file.ts"}}}"#)?
  assert method == METHOD_TEXT_DOCUMENT_DOCUMENT_SYMBOL
  let json = params?
  assert canonical(DocumentSymbolParams.to_json(DocumentSymbolParams.from_json(json)?)) == canonical(json)
  let result = result_of(r#"{"jsonrpc": "2.0", "id": 1, "result": [{"name": "add", "kind": 12, "range": {"start": {"line": 5, "character": 23}, "end": {"line": 6, "character": 0}}, "selectionRange": {"start": {"line": 5, "character": 23}, "end": {"line": 5, "character": 26}}, "children": [{"name": "a", "detail": "number", "kind": 13, "range": {"start": {"line": 5, "character": 23}, "end": {"line": 5, "character": 24}}, "selectionRange": {"start": {"line": 5, "character": 23}, "end": {"line": 5, "character": 24}}}]}]}"#)?
  let symbols = match result {
    Array(items) => items
    _ => []
  }
  var decoded: List<DocumentSymbol> = []
  for item in symbols {
    decoded.push(DocumentSymbol.from_json(item)?)
  }
  assert decoded[0].kind == SymbolKind.Function
  assert decoded[0].children != Option.None
  assert canonical(TextDocumentDocumentSymbolResult.to_json(TextDocumentDocumentSymbolResult.DocumentSymbolList(decoded))) == canonical(result)
}

test "a value of the wrong shape is refused with its place" {
  assert Position.from_json(parse(r#"{"line": -1, "character": 0}"#)?) == Err("Position.line: uinteger out of range")
  assert Position.from_json(parse(r#"{"line": 1}"#)?) == Err("Position.character: missing")
  assert CancelParams.from_json(parse(r#"{"id": true}"#)?) == Err("CancelParams.id: CancelParamsId: matches none of Integer, String")
  assert DidCloseTextDocumentParams.from_json(parse("[]")?) == Err("DidCloseTextDocumentParams: expected an object")
}

// ---- adversary cases (review of story:lsp-types) ----------------------------------------

test const HELIX_INITIALIZE: Text = r#"{"jsonrpc":"2.0","method":"initialize","params":{"capabilities":{"general":{"positionEncodings":["utf-8","utf-32","utf-16"]},"textDocument":{"codeAction":{"codeActionLiteralSupport":{"codeActionKind":{"valueSet":["","quickfix","refactor","refactor.extract","refactor.inline","refactor.rewrite","source","source.organizeImports"]}},"dataSupport":true,"disabledSupport":true,"isPreferredSupport":true,"resolveSupport":{"properties":["edit","command"]}},"completion":{"completionItem":{"deprecatedSupport":true,"insertReplaceSupport":true,"resolveSupport":{"properties":["documentation","detail","additionalTextEdits"]},"snippetSupport":true,"tagSupport":{"valueSet":[1]}},"completionItemKind":{}},"formatting":{"dynamicRegistration":false},"hover":{"contentFormat":["markdown"]},"inlayHint":{"dynamicRegistration":false},"publishDiagnostics":{"tagSupport":{"valueSet":[1,2]},"versionSupport":true},"rename":{"dynamicRegistration":false,"honorsChangeAnnotations":false,"prepareSupport":true},"signatureHelp":{"signatureInformation":{"activeParameterSupport":true,"documentationFormat":["markdown"],"parameterInformation":{"labelOffsetSupport":true}}}},"window":{"workDoneProgress":true},"workspace":{"applyEdit":true,"configuration":true,"didChangeConfiguration":{"dynamicRegistration":false},"didChangeWatchedFiles":{"dynamicRegistration":true,"relativePatternSupport":false},"executeCommand":{"dynamicRegistration":false},"fileOperations":{"didRename":true,"willRename":true},"inlayHint":{"refreshSupport":false},"symbol":{"dynamicRegistration":false},"workspaceEdit":{"documentChanges":true,"failureHandling":"abort","normalizesLineEndings":false,"resourceOperations":["create","rename","delete"]},"workspaceFolders":true}},"clientInfo":{"name":"helix","version":"25.07.1 (001efa80)"},"processId":4078898,"rootPath":"/work/proj","rootUri":null,"workspaceFolders":[]},"id":0}"#

test "adversary: a captured helix 25.07 initialize decodes and re-encodes equal" {
  let (method, params) = call_of(HELIX_INITIALIZE)?
  assert method == METHOD_INITIALIZE
  let json = params?
  let decoded = InitializeParams.from_json(json)?
  assert decoded.root_uri == Option.None
  assert decoded.workspace_folders == Some(Some([]))
  assert canonical(InitializeParams.to_json(decoded)) == canonical(json)
}

test "adversary: absent, null and a value stay apart through decode and encode" {
  let absent = InitializeParams.from_json(parse(r#"{"processId": null, "rootUri": null, "capabilities": {}}"#)?)?
  assert absent.workspace_folders == Option.None
  assert absent.root_path == Option.None
  assert InitializeParams.to_json(absent).get("workspaceFolders") == Option.None
  let null = InitializeParams.from_json(parse(r#"{"processId": null, "rootUri": null, "capabilities": {}, "workspaceFolders": null}"#)?)?
  assert null.workspace_folders == Some(Option.None)
  assert InitializeParams.to_json(null).get("workspaceFolders") == Some(Json.Null)
  let value = InitializeParams.from_json(parse(r#"{"processId": null, "rootUri": null, "capabilities": {}, "workspaceFolders": []}"#)?)?
  assert value.workspace_folders == Some(Some([]))
  assert InitializeParams.to_json(value).get("workspaceFolders") == Some(Json.Array([]))
}

test "adversary: a closed enumeration refuses a value it does not list, a custom one keeps it" {
  assert DiagnosticTag.from_json(Json.Number(3)) == Err("DiagnosticTag: not one of its values")
  assert PositionEncodingKind.from_json(Json.Str("utf-7")) == Ok(PositionEncodingKind.Custom("utf-7"))
}

test "adversary: uinteger accepts 2^31 - 1 and refuses 2^31 and negatives (LSP 3.17 Base Types)" {
  assert Position.from_json(parse(r#"{"line": 2147483647, "character": 0}"#)?)?.line == 2147483647
  assert Position.from_json(parse(r#"{"line": 2147483648, "character": 0}"#)?) == Err("Position.line: uinteger out of range")
  assert Position.from_json(parse(r#"{"line": 0, "character": -1}"#)?) == Err("Position.character: uinteger out of range")
}

test "adversary: a decimal diagnostic code matches no arm" {
  match DiagnosticCode.from_json(parse("1.5")?) {
    Err(_) => {}
    Ok(other) => { assert false, "a decimal code decoded as {other.debug()}" }
  }
  match DiagnosticCode.from_json(parse("1.0")?) {
    Err(_) => {}
    Ok(other) => { assert false, "1.0 decoded as {other.debug()}" }
  }
}

// TextDocumentContentChangeEvent is `{range, rangeLength?, text} | {text}`. An incremental
// change whose range does not decode must be refused: falling through to the `{text}` arm
// turns it into a full-document replacement, and a server applying it replaces the whole
// buffer with the fragment.
test "adversary: an incremental change with a bad range is refused, not read as a full replacement" {
  var wrong: List<Text> = []
  for text in [
    r#"{"range": {"start": {"line": 0, "character": -1}, "end": {"line": 0, "character": 0}}, "text": "x"}"#,
    r#"{"range": {"start": {"line": 2147483648, "character": 0}, "end": {"line": 0, "character": 0}}, "text": "x"}"#,
    r#"{"range": {"start": {"line": 0}, "end": {"line": 0, "character": 0}}, "text": "x"}"#,
    r#"{"range": {"start": {"line": 0, "character": 0}, "end": {"line": 0, "character": 1}}, "rangeLength": -1, "text": "x"}"#,
    r#"{"range": "0:0-0:1", "text": "x"}"#
  ] {
    match TextDocumentContentChangeEvent.from_json(parse(text)?) {
      Err(_) => {}
      Ok(other) => wrong.push("{text} decoded as {other.debug()}")
    }
  }
  assert wrong == [], "accepted: {wrong.debug()}"
}

// The same fall-through in other unions: a malformed member of the more specific arm drops
// that arm and a looser one, which ignores the member, accepts the value; the member is lost
// and the value does not re-encode equal.
test "adversary: a malformed member of the specific arm is refused, not dropped by a looser arm" {
  var wrong: List<Text> = []
  let tokens = parse(r#"{"legend": {"tokenTypes": [], "tokenModifiers": []}, "documentSelector": [{"language": 5}]}"#)?
  match ServerCapabilitiesSemanticTokensProvider.from_json(tokens) {
    Err(_) => {}
    Ok(other) => wrong.push("documentSelector dropped: {other.debug()}")
  }
  let filter = parse(r#"{"notebook": 5, "language": "rust"}"#)?
  match DocumentFilter.from_json(filter) {
    Err(_) => {}
    Ok(other) => wrong.push("notebook dropped: {other.debug()}")
  }
  assert wrong == [], "accepted: {wrong.debug()}"
}
