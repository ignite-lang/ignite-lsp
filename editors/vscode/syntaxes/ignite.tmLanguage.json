{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ignite",
  "scopeName": "source.ignite",
  "fileTypes": ["ignite"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#declaration" },
    { "include": "#test" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#function-call" },
    { "include": "#types" },
    { "include": "#operators" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-slash.ignite",
      "match": "//.*$"
    },
    "declaration": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+(?:([A-Z][A-Za-z0-9_]*)\\s*\\.\\s*)?([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.function.ignite storage.type.function.ignite" },
            "2": { "name": "entity.name.type.ignite" },
            "3": { "name": "entity.name.function.ignite" }
          }
        },
        {
          "match": "\\b(type|enum|system|protocol|interface)\\s+([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.ignite" },
            "2": { "name": "entity.name.type.ignite" }
          }
        },
        {
          "match": "\\b(resource|component|contract|policy|assembly)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.ignite" },
            "2": { "name": "variable.other.member.ignite" }
          }
        },
        {
          "match": "\\b(package|import)\\s+([A-Za-z_][A-Za-z0-9_.]*)",
          "captures": {
            "1": { "name": "keyword.control.import.ignite" },
            "2": { "name": "entity.name.namespace.ignite" }
          }
        }
      ]
    },
    "test": {
      "match": "\\b(test)\\s+(?=\")",
      "captures": {
        "1": { "name": "keyword.other.test.ignite" }
      }
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.raw.ignite",
          "begin": "\\b(b?r)(#*)\"",
          "beginCaptures": { "1": { "name": "storage.type.string.ignite" } },
          "end": "\"\\2"
        },
        {
          "name": "string.quoted.double.byte.ignite",
          "begin": "\\bb\"",
          "end": "\"",
          "patterns": [{ "include": "#escape" }]
        },
        {
          "name": "string.quoted.single.byte.ignite",
          "match": "\\bb'(?:\\\\x[0-9A-Fa-f]{2}|\\\\.|[^'\\\\])'"
        },
        {
          "name": "string.quoted.double.ignite",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "include": "#escape" },
            { "name": "constant.character.escape.brace.ignite", "match": "\\{\\{|\\}\\}" },
            {
              "name": "meta.interpolation.ignite",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.ignite" } },
              "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.ignite" } },
              "patterns": [
                { "include": "#strings" },
                { "include": "#numbers" },
                { "include": "#keywords" },
                { "include": "#function-call" },
                { "include": "#types" },
                { "include": "#operators" }
              ]
            }
          ]
        }
      ]
    },
    "escape": {
      "name": "constant.character.escape.ignite",
      "match": "\\\\(?:x[0-9A-Fa-f]{2}|[nrtvf0\\\\\"'])"
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b(0[xX][0-9A-Fa-f_]+|[0-9][0-9_]*(?:\\.[0-9][0-9_]*)?)(?:\\s*(%)|\\s+(ns|us|ms|seconds?|minutes?|hours?|days?|bytes?|KiB|MiB|GiB|KB|MB|GB)\\b)?",
          "captures": {
            "1": { "name": "constant.numeric.ignite" },
            "2": { "name": "keyword.other.unit.ignite" },
            "3": { "name": "keyword.other.unit.ignite" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.conditional.ignite", "match": "\\b(if|else|match)\\b" },
        { "name": "keyword.control.loop.ignite", "match": "\\b(while|loop|for|in|break|continue)\\b" },
        { "name": "keyword.control.return.ignite", "match": "\\breturn\\b" },
        { "name": "keyword.control.import.ignite", "match": "\\b(package|import)\\b" },
        { "name": "storage.type.function.ignite", "match": "\\bfn\\b" },
        {
          "name": "storage.type.ignite",
          "match": "\\b(type|enum|system|resource|component|contract|policy|assembly|protocol|interface)\\b"
        },
        { "name": "storage.modifier.ignite", "match": "\\b(let|var|const)\\b" },
        {
          "name": "keyword.other.ignite",
          "match": "\\b(requires|satisfies|verifies|conforms|scope|unsupported|not_applicable|test|assert|await|spawn)\\b"
        },
        { "name": "constant.language.boolean.ignite", "match": "\\b(true|false)\\b" },
        { "name": "support.function.builtin.ignite", "match": "\\b(module|event|rolling|exponential)\\b(?=\\s*\\()" }
      ]
    },
    "function-call": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.call.ignite" }
      }
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.builtin.ignite",
          "match": "\\b(Int|Bool|Byte|Text|Bytes|Unit|List|Map|Option|Result|Duration|ByteSize|Ratio|Ref|IoError|TcpListener|TcpStream|PipeStream|Pipe|ByteStream|Endpoint|Exposure|Store|Data|Eof)\\b"
        },
        { "name": "support.constant.variant.ignite", "match": "\\b(Some|None|Ok|Err)\\b" },
        { "name": "entity.name.type.ignite", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.arrow.ignite", "match": "=>|->" },
        { "name": "keyword.operator.comparison.ignite", "match": "==|!=|<=|>=" },
        { "name": "keyword.operator.logical.ignite", "match": "\\|\\||&&|!" },
        { "name": "keyword.operator.question.ignite", "match": "\\?" },
        { "name": "keyword.operator.ignite", "match": "[-+*/%=<>|]" }
      ]
    }
  }
}
